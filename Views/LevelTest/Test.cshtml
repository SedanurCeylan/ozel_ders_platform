@model LevelTestViewModel
@{ViewData["Title"]=$"{Model.Grade}. Sınıf Seviye Testi";}
<section class="level-test-page"><div class="container test-shell"><div class="test-heading"><span>@Model.Grade. SINIF · 5 SORU</span><h1>Mini Seviye Testi</h1><p>Tüm soruları cevaplayıp sonucunu görüntüle.</p></div><form asp-action="Result" method="post"><input type="hidden" name="token" value="@Model.Token"/>@for(var index=0;index<Model.Questions.Count;index++){var q=Model.Questions[index];<fieldset class="test-question"><legend><small>SORU @(index+1) · @q.Topic</small>@q.QuestionText</legend><div>@foreach(var option in q.Options.OrderBy(x=>x.DisplayOrder)){<label><input type="radio" name="answers[@q.Id]" value="@option.OptionText" required/><span>@option.OptionText</span></label>}</div></fieldset>}<button class="btn btn-primary btn-lg test-submit">Sonucumu Gör →</button></form></div></section>
