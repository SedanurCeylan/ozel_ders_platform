@model LevelTestResultViewModel
@{ViewData["Title"]="Seviye Testi Sonucu";}
<section class="level-test-page"><div class="container test-result"><span>TEST TAMAMLANDI</span><h1>%@Model.Accuracy başarı</h1><div class="result-numbers"><div><strong>@Model.Correct</strong><small>Doğru</small></div><div><strong>@Model.Wrong</strong><small>Yanlış</small></div><div><strong>@Model.Grade.</strong><small>Sınıf</small></div></div><section><h2>Genel öneri</h2><p>@Model.Recommendation</p></section><div class="topic-result"><section><h2>Güçlü konular</h2><p>@(Model.StrongTopics.Count==0?"Henüz belirlenemedi.":string.Join(", ",Model.StrongTopics))</p></section><section><h2>Geliştirilecek konular</h2><p>@(Model.DevelopmentTopics.Count==0?"Harika, belirgin bir eksik görünmüyor.":string.Join(", ",Model.DevelopmentTopics))</p></section></div><div class="result-actions"><a class="btn btn-primary" asp-action="Index">Tekrar Çöz</a><a class="btn" asp-controller="Home" asp-action="Index" asp-fragment="iletisim">Ders Bilgisi Al</a></div></div></section>
