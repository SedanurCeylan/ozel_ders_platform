@model OzelDersYonetim.Services.Games.PublicGameResult
@{ViewData["Title"]="Oyun Sonucu";}
<section class="public-games"><div class="container"><div class="result-card"><span class="result-kicker">ARENA TAMAMLANDI</span><div class="result-medal">✓</div><h1>Harika Mücadele!</h1><strong class="result-score">@Model.Score <small>puan</small></strong><div class="result-metrics"><div><b>@Model.Correct</b><span>Doğru</span></div><div><b>@Model.Wrong</b><span>Yanlış</span></div><div><b>%@Model.Accuracy</b><span>Başarı</span></div><div><b>@Model.AverageAnswerTime sn</b><span>Ort. cevap</span></div><div><b>@Model.LongestStreak</b><span>En uzun seri</span></div><div><b>@Model.DurationSeconds sn</b><span>Oyun süresi</span></div></div><div class="result-actions"><a class="game-start" asp-action="Index">Yeniden Oyna</a><a asp-controller="Home" asp-action="Index">Ana Sayfaya Dön</a></div></div></div></section>
