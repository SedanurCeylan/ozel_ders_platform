@using OzelDersYonetim.Services.Games
@{Layout=null;var q=(PublicGameQuestion)ViewBag.Question;}
<!DOCTYPE html><html lang="tr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>İşlem Arenası | Matematik Atölyesi</title><link rel="stylesheet" href="~/css/games.css" asp-append-version="true"/></head><body class="public-arena-body"><form class="arena-token">@Html.AntiForgeryToken()</form><div class="arena-shell" data-token="@ViewBag.Token" data-end="@ViewBag.EndUnixMs"><header class="arena-top"><a asp-action="Index">← Çık</a><div><span>KALAN SÜRE</span><strong id="timer">--</strong></div><div><span>PUAN</span><strong id="score">0</strong></div><div><span>DOĞRU</span><strong id="correct">0</strong></div><div><span>YANLIŞ</span><strong id="wrong">0</strong></div><div><span>SERİ</span><strong id="streak">0</strong></div></header><div class="arena-progress"><span id="studentProgress"></span><i id="opponentProgress"></i></div><main class="arena-question"><small id="questionNumber">SORU @q.Number</small><h1 id="questionText">@q.Text</h1><div id="answerArea" class="answer-grid">@foreach(var option in q.Options){<button type="button" data-answer="@option">@option</button>}</div><div id="feedback" aria-live="polite"></div></main></div><script>window.publicArenaToken=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Token));window.publicArenaQuestion=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(q,new System.Text.Json.JsonSerializerOptions{PropertyNamingPolicy=System.Text.Json.JsonNamingPolicy.CamelCase}));</script><script src="~/js/public-operation-arena.js" asp-append-version="true"></script></body></html>
