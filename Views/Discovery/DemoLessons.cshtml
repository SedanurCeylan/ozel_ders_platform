@model PublicCollectionViewModel
@{ViewData["Title"]=Model.Title;}
<section class="discovery-hero"><div class="container"><span>ÜCRETSİZ İZLE</span><h1>@Model.Title</h1><p>@Model.Description</p></div></section><section class="section"><div class="container discovery-grid">@if(Model.Items.Count==0){<div class="public-empty">Yayında demo ders bulunmuyor.</div>}@foreach(var item in Model.Items){<article class="discovery-card"><div class="video-cover"><span>▶</span></div><small>@item.Subtitle</small><h2>@item.Title</h2><p>@item.Content</p>@if(Uri.TryCreate(item.Subtitle,UriKind.Absolute,out _)){<a href="@item.Subtitle" target="_blank" rel="noopener">Dersi İzle →</a>}else{<span class="coming-label">Video bağlantısı hazırlanıyor</span>}</article>}</div></section>
