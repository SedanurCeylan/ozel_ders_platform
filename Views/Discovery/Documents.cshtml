@model PublicCollectionViewModel
@{ViewData["Title"]=Model.Title;}
<section class="discovery-hero documents"><div class="container"><span>ÜCRETSİZ KAYNAKLAR</span><h1>@Model.Title</h1><p>@Model.Description</p></div></section><section class="section"><div class="container document-public-grid">@if(Model.Documents.Count==0){<div class="public-empty">Yayında ücretsiz doküman bulunmuyor.</div>}@foreach(var item in Model.Documents){<article><span>PDF</span><div><small>@item.Category · @((item.FileSize/1024d/1024d).ToString("0.##")) MB</small><h3>@item.Title</h3><p>@item.Description</p></div><a asp-action="Download" asp-route-id="@item.Id">Ücretsiz İndir ↓</a></article>}</div></section>
