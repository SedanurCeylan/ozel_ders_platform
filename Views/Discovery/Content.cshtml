@model PublicCollectionViewModel
@{ViewData["Title"]=Model.Title;var symbols=new[]{"½","⏱","✓","π","∞","√","x²","%"};}
<section class="discovery-hero content"><div class="discovery-orbits" aria-hidden="true"><i>π</i><i>∞</i><i>√</i></div><div class="container"><span>OKU · KEŞFET · UYGULA</span><h1>@Model.Title</h1><p>@Model.Description</p><div class="content-hero-meta"><b>@Model.Items.Count</b><small>keşfedilecek içerik</small></div></div></section><section class="section content-library"><div class="container content-library-head"><div><span>MATEMATİK KÜTÜPHANESİ</span><h2>Merak ettiğin yerden başla</h2></div><p>Kısa anlatımlar, uygulanabilir çalışma önerileri ve matematiği günlük hayatla buluşturan bilgiler.</p></div><div class="container discovery-content-grid">@if(Model.Items.Count==0){<div class="public-empty">Yayında içerik bulunmuyor.</div>}@for(var i=0;i<Model.Items.Count;i++){var item=Model.Items[i];<a class="discovery-content-card" asp-action="Article" asp-route-key="@item.SectionKey"><header><span>@symbols[i%symbols.Length]</span><small>@(item.Subtitle??"Matematik Keşfi")</small><i>#@((i+1).ToString("00"))</i></header><h2>@item.Title</h2><p>@item.Content</p><footer><span>3 dakikalık keşif</span><b>Okumaya başla →</b></footer></a>}</div></section>
