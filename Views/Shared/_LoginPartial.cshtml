@using Microsoft.AspNetCore.Identity
@using OzelDersYonetim.Models.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center login-menu">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="btn btn-primary nav-login" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Yönetim Paneli</a>
        </li>
    }
    else if (User.IsInRole("Student"))
    {
        <li class="nav-item">
            <a class="btn btn-primary nav-login" asp-area="Student" asp-controller="Dashboard" asp-action="Index">Öğrenci Panelim</a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Hesabım">Hesabım</a>
    </li>
    <li class="nav-item">
        <form  class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link">Çıkış</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-primary nav-login" asp-area="Identity" asp-page="/Account/Login">Öğrenci Girişi</a>
    </li>
}
</ul>
