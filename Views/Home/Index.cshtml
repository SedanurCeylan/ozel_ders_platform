@model PublicSiteViewModel
@using OzelDersYonetim.Models.Games
@{ViewData["Title"]="Matematiği Anlamanın Yeni Yolu";var s=Model.Settings;var configs=Model.Sections.Where(x=>x.SectionKey.StartsWith("section-")).OrderBy(x=>x.DisplayOrder).ToList();}

@foreach(var homeSection in configs)
{
    switch(homeSection.SectionKey)
    {
        case "section-hero":
            var heroTopic=Model.Find("hero-topic");var heroSolution=Model.Find("hero-solution");var heroProgress=Model.Find("hero-progress");var heroStat1=Model.Find("hero-stat-1");var heroStat2=Model.Find("hero-stat-2");var heroStat3=Model.Find("hero-stat-3");
            <section class="hero-section"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow"><span></span> @homeSection.Subtitle</span><h1>@s.HeroTitle</h1><p class="hero-lead">@s.HeroDescription</p><div class="hero-actions"><a class="btn btn-primary btn-lg" asp-action="Trainings">Eğitimleri İncele →</a><a class="btn btn-outline-primary btn-lg" asp-controller="Games" asp-action="Index">Ücretsiz Oyna</a><a class="text-link" href="#iletisim">İletişime Geç</a></div><div class="trust-row"><div><strong>@(heroStat1?.Title??"1:1")</strong><span>@(heroStat1?.Content??"Birebir ilgi")</span></div><div><strong>@(heroStat2?.Title??"%100")</strong><span>@(heroStat2?.Content??"Kişisel plan")</span></div><div><strong>@(heroStat3?.Title??"5–8")</strong><span>@(heroStat3?.Content??"Sınıf düzeyi")</span></div></div></div><div class="hero-visual"><div class="formula-card formula-main"><div class="formula-head"><span>@(heroTopic?.Title??"Bugünün konusu")</span><span class="status-dot">Canlı</span></div><p class="formula">@(heroTopic?.Content??"x² − 5x + 6 = 0")</p><div class="solution-steps"><span>@(heroSolution?.Title??"(x − 2)(x − 3) = 0")</span><strong>@(heroSolution?.Content??"x = 2 veya x = 3")</strong></div></div><div class="formula-card mini-card mini-progress"><span class="mini-icon">↗</span><div><strong>@(heroProgress?.Title??"+24%")</strong><small>@(heroProgress?.Content??"Net gelişimi")</small></div></div></div></div></section>
            break;
        case "section-teacher":
            <section class="section home-teacher"><div class="container home-split"><div class="teacher-portrait"><span>∑</span><small>@s.TeacherName</small></div><div><span class="eyebrow"><span></span> @homeSection.Subtitle</span><h2>@homeSection.Title</h2><p>@homeSection.Content</p><ul class="check-list"><li>Kişiye özel ders ve çalışma planı</li><li>Düzenli ödev, deneme ve gelişim takibi</li><li>Çevrim içi, yüz yüze veya hibrit ders seçeneği</li></ul><a class="btn btn-primary" asp-action="About">Hakkımda →</a></div></div></section>
            break;
        case "section-demo":
            var demo=Model.Find("demo-featured");
            if(demo is not null){<section class="section home-demo"><div class="container home-section-head"><span>@homeSection.Subtitle</span><h2>@homeSection.Title</h2><p>@homeSection.Content</p></div><div class="container demo-card"><div class="demo-screen"><span>▶</span></div><div><small>ÖNE ÇIKAN DEMO</small><h3>@demo.Title</h3><p>@demo.Content</p>@if(Uri.TryCreate(demo.Subtitle,UriKind.Absolute,out _)){<a class="btn btn-primary" href="@demo.Subtitle" target="_blank" rel="noopener">Demo Dersi İzle →</a>}</div></div></section>}
            break;
        case "section-grades":
            var grades=Model.Sections.Where(x=>x.SectionKey.StartsWith("program-")).Take(4).ToList();
            <section class="section soft-section"><div class="container home-section-head"><span>@homeSection.Subtitle</span><h2>@homeSection.Title</h2><p>@homeSection.Content</p></div><div class="container home-card-grid">@foreach(var item in grades){<article><span>@item.Subtitle</span><h3>@item.Title</h3><p>@item.Content</p><a asp-action="SecondaryEducation">Sınıfı İncele →</a></article>}</div></section>
            break;
        case "section-programs":
            var programs=Model.Sections.Where(x=>x.SectionKey.StartsWith("program-")).ToList();
            <section class="section course-preview"><div class="container split-heading"><div><span class="eyebrow light"><span></span> @homeSection.Subtitle</span><h2>@homeSection.Title</h2></div><a class="btn btn-outline-light" asp-action="Trainings">Tüm Eğitimler →</a></div><div class="container course-grid">@foreach(var item in programs){<article class="course-card"><span class="course-level">@item.Subtitle</span><h3>@item.Title</h3><p>@item.Content</p><a asp-action="Trainings">Programı İncele →</a></article>}</div></section>
            break;
        case "section-content":
            var contentItems=Model.Items("content-").Take(6).ToList();
            var contentSymbols=new[]{"½","⏱","✓","π","∞","√"};
            <section class="section home-content-showcase"><div class="content-bg-symbols" aria-hidden="true"><span>π</span><span>√</span><span>∞</span></div><div class="container content-showcase-head"><div><span>@homeSection.Subtitle</span><h2>@homeSection.Title</h2><p>@homeSection.Content</p></div><a asp-controller="Discovery" asp-action="Content">Tüm içerikleri keşfet <b>→</b></a></div>@if(contentItems.Count>0){<div class="container content-magazine-grid">@for(var i=0;i<contentItems.Count;i++){var item=contentItems[i];<article class="content-magazine-card @(i==0?"featured":"")"><div class="content-card-top"><span class="content-symbol">@contentSymbols[i%contentSymbols.Length]</span><small>@(item.Subtitle??"Matematik Keşfi")</small><i>@(i+1).ToString("00")</i></div><div><h3>@item.Title</h3><p>@item.Content</p></div><a asp-controller="Discovery" asp-action="Content">Okumaya devam et <span>↗</span></a></article>}</div>}</section>
            break;
        case "section-daily":
            if(Model.DailyFact is { } fact){<section class="section daily-section fact-showcase"><div class="fact-symbols" aria-hidden="true"><span>π</span><span>√</span><span>∞</span><span>∑</span><span>x²</span></div><div class="container"><div class="fact-kicker"><span>HER GÜN YENİ BİR KEŞİF</span><small>@DateTime.Today.ToString("dd MMMM yyyy")</small></div><div class="fact-stage"><div class="fact-intro"><div class="fact-orbit" aria-hidden="true"><i>?</i><b>π</b><b>∞</b><b>√</b></div><span>@homeSection.Subtitle</span><h2>Bunu biliyor<br/>muydun?</h2><p>@homeSection.Content</p></div><article class="daily-fact"><header><span>@fact.Category</span><strong>#@fact.DisplayOrder.ToString("00")</strong></header><div class="fact-quote">“</div><h3>@fact.Title</h3><p>@fact.Content</p><footer><span><i>✦</i> Bugünün matematik keşfi</span><small>Yarın yenisi burada</small></footer></article></div><div class="fact-dots" aria-label="Günlük bilgi sırası"><i class="active"></i><i></i><i></i><span>Her gün otomatik değişir</span></div></div></section>}
            break;
        case "section-games":
            <section class="section home-games"><div class="container home-split"><div><span class="eyebrow light"><span></span> @homeSection.Subtitle</span><h2>@homeSection.Title</h2><p>@homeSection.Content</p><a class="btn btn-primary btn-lg" asp-controller="Games" asp-action="Index">İşlem Arenası'nı Oyna →</a></div><div class="game-promo"><span>× ÷ + −</span><strong>İşlem Arenası</strong><small>Aktif · Giriş gerektirmez</small></div></div></section>
            break;
        case "section-documents":
            if(Model.PublicDocuments.Count>0){<section class="section"><div class="container home-section-head"><span>@homeSection.Subtitle</span><h2>@homeSection.Title</h2><p>@homeSection.Content</p></div><div class="container document-public-grid">@foreach(var item in Model.PublicDocuments){<article><span>PDF</span><div><small>@item.Category · @((item.FileSize/1024d/1024d).ToString("0.##")) MB</small><h3>@item.Title</h3><p>@item.Description</p></div><a asp-action="PublicDocument" asp-route-id="@item.Id">Ücretsiz İndir ↓</a></article>}</div></section>}
            break;
        case "section-process":
            <section class="section soft-section"><div class="container home-section-head"><span>@homeSection.Subtitle</span><h2>@homeSection.Title</h2><p>@homeSection.Content</p></div><div class="container process-grid">@foreach(var item in Model.Items("process-")){<article><span>@item.DisplayOrder.ToString("00")</span><h3>@item.Title</h3><p>@item.Content</p></article>}</div></section>
            break;
        case "section-tracking":
            <section class="section tracking-section"><div class="container home-section-head"><span>@homeSection.Subtitle</span><h2>@homeSection.Title</h2><p>@homeSection.Content</p></div><div class="container home-card-grid">@foreach(var item in Model.Items("tracking-")){<article><span>✓</span><h3>@item.Title</h3><p>@item.Content</p></article>}</div><div class="container center-action"><a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Öğrenci Girişi →</a></div></section>
            break;
        case "section-stats":
            <section class="section stats-section"><div class="container home-section-head"><span>@homeSection.Subtitle</span><h2>@homeSection.Title</h2></div><div class="container stat-grid">@foreach(var item in Model.Items("stat-")){<article><strong>@item.Content</strong><span>@item.Title</span><small>@item.Subtitle</small></article>}</div></section>
            break;
        case "section-testimonials":
            if(Model.StudentTestimonials.Count>0){<section class="section real-testimonials"><div class="container home-section-head"><span>@homeSection.Subtitle</span><h2>@homeSection.Title</h2><p>Öğrencilerimizin kendi hesaplarından paylaştığı gerçek ders deneyimleri.</p></div><div class="container testimonial-grid">@foreach(var item in Model.StudentTestimonials){<blockquote><div class="public-testimonial-stars">@string.Concat(Enumerable.Repeat("★",item.Rating))@string.Concat(Enumerable.Repeat("☆",5-item.Rating))</div><p>“@item.Comment”</p><footer><span class="testimonial-avatar">@item.StudentProfile.FirstName[0]@item.StudentProfile.LastName[0]</span><div><strong>@item.PublicStudentName</strong><span>@item.StudentProfile.GradeLevel · Kayıtlı öğrenci</span></div><i>✓ Doğrulandı</i></footer></blockquote>}</div></section>}
            break;
        case "section-faq":
            <section class="section faq-section"><div class="container home-section-head"><span>@homeSection.Subtitle</span><h2>@homeSection.Title</h2><p>@homeSection.Content</p></div><div class="container faq-list">@foreach(var item in Model.Items("faq-")){<details><summary>@item.Title</summary><p>@item.Content</p></details>}</div></section>
            break;
    }
}

@if(Model.Find("cta") is { } cta){<section class="section cta-section"><div class="container cta-card"><div><span class="eyebrow"><span></span> İlk adımı birlikte atalım</span><h2>@cta.Title</h2><p>@cta.Content</p></div><a class="btn btn-primary btn-lg" href="#iletisim">İletişime Geç →</a></div></section>}
@if(Model.Find("contact") is { } contact){<section class="section contact-section" id="iletisim"><div class="container contact-grid"><div class="contact-copy"><span class="eyebrow"><span></span> İletişim</span><h2>@contact.Title</h2><p>@contact.Content</p><ul><li>✉ @(s.Email??"E-posta bilgisi yönetici tarafından eklenecek")</li>@if(!string.IsNullOrWhiteSpace(s.Phone)){<li>☎ @s.Phone</li>}</ul></div><form id="contactForm" class="contact-form"><input type="hidden" name="to_email" value="@s.Email"/><label>Adınız soyadınız<input name="from_name" required maxlength="120"/></label><label>E-posta adresiniz<input name="reply_to" type="email" required maxlength="180"/></label><label>Telefon<input name="phone" type="tel" maxlength="40"/></label><label>Sınıf seviyesi<select name="grade"><option value="">Seçiniz</option>@for(var grade=5;grade<=8;grade++){<option>@grade. Sınıf</option>}</select></label><label class="wide">Mesajınız<textarea name="message" required rows="5" maxlength="1500"></textarea></label><button class="btn btn-primary btn-lg wide" type="submit">Mesajı Gönder →</button><p class="contact-status wide" id="contactStatus" role="status"></p></form></div></section>}

@section Scripts{<script src="~/js/home-features.js" asp-append-version="true"></script>@if(!string.IsNullOrWhiteSpace(s.EmailJsPublicKey)&&!string.IsNullOrWhiteSpace(s.EmailJsServiceId)&&!string.IsNullOrWhiteSpace(s.EmailJsTemplateId)){<script src="https://cdn.jsdelivr.net/npm/@@emailjs/browser@4/dist/email.min.js"></script><script>emailjs.init({publicKey:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(s.EmailJsPublicKey))});window.bindContactForm?.(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(s.EmailJsServiceId)),@Html.Raw(System.Text.Json.JsonSerializer.Serialize(s.EmailJsTemplateId)));</script>}}
