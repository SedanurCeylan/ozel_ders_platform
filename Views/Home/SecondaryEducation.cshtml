@model PublicSiteViewModel
@{ ViewData["Title"]="Sınıf İçerikleri"; }
<section class="inner-hero compact"><div class="container"><span class="eyebrow"><span></span> Sınıf içerikleri</span><h1>5–8. sınıf matematik yol haritası</h1><p>Her sınıfın programı ve konu başlıkları yönetici panelinden güncellenebilir.</p></div></section><section class="section"><div class="container topic-layout"><aside class="level-panel"><span>Sınıf düzeyleri</span>@foreach(var item in Model.Sections){<a href="#@item.SectionKey">@item.Subtitle</a>}</aside><div class="topic-list">@foreach(var item in Model.Sections){var topics=item.Content.Split('|',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);<article id="@item.SectionKey"><div class="grade-badge">@item.DisplayOrder.ToString("00")</div><div><h2>@item.Title</h2>@if(topics.Length>0){<div class="topic-tags">@foreach(var topic in topics){<span>@topic</span>}</div>}</div></article>}</div></div></section>
