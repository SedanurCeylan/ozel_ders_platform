@page
@model OzelDersYonetim.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{ ViewData["Title"] = "Şifre Değiştir"; }
<section class="account-section"><div class="account-wrap"><partial name="_ManageNav"/><div class="account-card"><div class="account-heading"><span>Güvenlik</span><h1>Şifre Değiştir</h1><p>Hesabınız için güçlü ve yalnızca sizin bildiğiniz bir şifre belirleyin.</p></div>@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="account-success">✓ @Model.StatusMessage</div>}<form method="post"><div asp-validation-summary="ModelOnly" class="login-validation"></div><div class="login-field"><label asp-for="Input.OldPassword"></label><input asp-for="Input.OldPassword" autocomplete="current-password"/><span asp-validation-for="Input.OldPassword"></span></div><div class="account-grid"><div class="login-field"><label asp-for="Input.NewPassword"></label><input asp-for="Input.NewPassword" autocomplete="new-password"/><span asp-validation-for="Input.NewPassword"></span></div><div class="login-field"><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" autocomplete="new-password"/><span asp-validation-for="Input.ConfirmPassword"></span></div></div><div class="password-hint">En az 10 karakter, büyük/küçük harf, rakam ve özel karakter kullanın.</div><button class="btn btn-primary account-submit" type="submit">Şifreyi Değiştir →</button></form></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
