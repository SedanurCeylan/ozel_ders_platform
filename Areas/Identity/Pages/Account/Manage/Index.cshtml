@page
@model OzelDersYonetim.Areas.Identity.Pages.Account.Manage.IndexModel
@{ ViewData["Title"] = "Hesabım"; var student=User.IsInRole("Student"); }
<section class="account-section"><div class="account-wrap"><partial name="_ManageNav"/><div class="account-card"><div class="account-heading"><span>Profil bilgileri</span><h1>Hesabım</h1><p>İletişim ve kişisel bilgilerinizi güncelleyin.</p></div>@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="account-success">✓ @Model.StatusMessage</div>}<form method="post"><div asp-validation-summary="ModelOnly" class="login-validation"></div><div class="login-field"><label>E-posta adresi</label><input value="@Model.Email" disabled /><small>E-posta adresi ve sınıf seviyesi yalnızca yönetici tarafından değiştirilebilir.</small></div><div class="account-grid"><div class="login-field"><label asp-for="Input.FirstName"></label><input asp-for="Input.FirstName"/><span asp-validation-for="Input.FirstName"></span></div><div class="login-field"><label asp-for="Input.LastName"></label><input asp-for="Input.LastName"/><span asp-validation-for="Input.LastName"></span></div></div><div class="login-field"><label asp-for="Input.PhoneNumber"></label><input asp-for="Input.PhoneNumber" placeholder="05xx xxx xx xx"/><span asp-validation-for="Input.PhoneNumber"></span></div>@if(student){<div class="account-grid"><div class="login-field"><label asp-for="Input.BirthDate"></label><input asp-for="Input.BirthDate" type="date"/><span asp-validation-for="Input.BirthDate"></span></div><div class="login-field"><label asp-for="Input.SchoolName"></label><input asp-for="Input.SchoolName"/><span asp-validation-for="Input.SchoolName"></span></div></div><div class="login-field"><label asp-for="Input.LessonPreference"></label><select asp-for="Input.LessonPreference"><option value="Online">Çevrim içi</option><option value="Yüz yüze">Yüz yüze</option><option value="Hibrit">Hibrit</option></select><span asp-validation-for="Input.LessonPreference"></span></div>}<button class="btn btn-primary account-submit" type="submit">Bilgileri Kaydet →</button></form></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
