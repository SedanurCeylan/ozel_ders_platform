@model IReadOnlyList<CourseDocument>
@{ ViewData["Title"] = "Dokümanlarım"; }
<div class="student-page-title"><span>Kaynaklarım</span><h1>Dokümanlarım</h1><p>Öğretmeninizin sizinle paylaştığı çalışma dosyalarını indirin.</p></div><div class="student-filter"><a class="@(ViewBag.Category is null ? "active" : "")" asp-action="Index">Tümü</a>@foreach(string category in ViewBag.Categories){<a class="@(ViewBag.Category==category?"active":"")" asp-route-category="@category">@category</a>}</div><div class="document-grid">@if(Model.Count==0){<div class="student-empty">Sizinle paylaşılmış doküman bulunmuyor.</div>}@foreach(var item in Model){<article><span>▤</span><div><small>@item.Category</small><h2>@item.Title</h2><p>@item.Description</p><em>@((item.FileSize/1024d/1024d).ToString("0.##")) MB · @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</em></div><a asp-action="Download" asp-route-id="@item.Id">İndir ↓</a></article>}</div>
