@model StudentProfile
@{ ViewData["Title"]="Profilim"; }
<div class="student-page-title"><span>Hesabım</span><h1>Profilim</h1><p>Kayıtlı öğrenci ve veli bilgileriniz.</p><a class="student-action" asp-area="Identity" asp-page="/Account/Manage/Index">Profil Bilgilerimi Düzenle →</a></div>
<div class="profile-page"><div class="profile-card"><div class="large-avatar">@if(!string.IsNullOrWhiteSpace(Model.ProfileImagePath)){<img src="@Url.Action("Photo","Dashboard")" alt="@Model.FullName"/>}else{@Model.FirstName[0]@Model.LastName[0]}</div><h2>@Model.FullName</h2><span>@Model.GradeLevel</span><p>@Model.SchoolName</p><form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" class="profile-photo-form"><label>Profil fotoğrafını değiştir<input type="file" name="profileImage" accept="image/jpeg,image/png,image/webp"/></label><button type="submit">Fotoğrafı Yükle</button></form></div><div class="profile-info"><section><h2>İletişim</h2><dl><dt>E-posta</dt><dd>@Model.Email</dd><dt>Telefon</dt><dd>@(Model.Phone??"—")</dd><dt>Doğum tarihi</dt><dd>@(Model.BirthDate?.ToString("dd.MM.yyyy")??"—")</dd></dl></section><section><h2>Ders bilgileri</h2><dl><dt>Ders</dt><dd>@Model.LessonType</dd><dt>Tercih</dt><dd>@(Model.LessonPreference=="Online"?"Çevrim içi":Model.LessonPreference)</dd><dt>Kayıt tarihi</dt><dd>@Model.RegistrationDate.ToString("dd.MM.yyyy")</dd></dl></section><section><h2>Veli bilgileri</h2><dl><dt>Ad soyad</dt><dd>@Model.ParentFirstName @Model.ParentLastName</dd><dt>Telefon</dt><dd>@(Model.ParentPhone??"—")</dd><dt>E-posta</dt><dd>@(Model.ParentEmail??"—")</dd></dl></section></div></div>
