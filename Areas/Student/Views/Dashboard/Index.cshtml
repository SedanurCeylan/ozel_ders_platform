@model StudentDashboardViewModel
@{ ViewData["Title"]="Panelim"; }
<section class="student-welcome"><div><span>@DateTime.Now.ToString("dd MMMM yyyy")</span><h1>Merhaba, @Model.Student.FirstName! 👋</h1><p>Derslerini, ödevlerini ve gelişimini buradan takip edebilirsin.</p></div><div class="student-score"><strong>@Model.Student.GradeLevel</strong><small>@Model.Student.LessonType</small></div></section>
<div class="student-stats dashboard-six"><article><span>◷</span><div><strong>@Model.UpcomingLessons.Count</strong><small>Yaklaşan ders</small></div></article><article><span>✓</span><div><strong>@Model.UpcomingAssignments.Count</strong><small>Bekleyen ödev</small></div></article><article><span>!</span><div><strong>@Model.LateAssignmentCount</strong><small>Geciken ödev</small></div></article><article><span>✎</span><div><strong>@Model.EvaluatedAssignmentCount</strong><small>Değerlendirilen</small></div></article><article><span>◉</span><div><strong>@Model.UnreadNotificationCount</strong><small>Yeni bildirim</small></div></article><article><span>▤</span><div><strong>@Model.DocumentCount</strong><small>Doküman</small></div></article></div>
<div class="student-grid"><section><div class="student-panel-head"><h2>Yaklaşan Derslerim</h2><a asp-controller="Lessons" asp-action="Index">Tümü →</a></div>@if(Model.UpcomingLessons.Count==0){<div class="dashboard-empty"><div class="dashboard-empty-symbol"><strong>∑</strong><span>+</span><strong>π</strong><span>=</span><strong>∞</strong></div><h3>Takvimin şu an boş</h3><p>Yeni bir ders planlandığında tarih ve saat bilgisi burada görünecek.</p><a asp-controller="Lessons" asp-action="Index">Derslerimi görüntüle →</a></div>}else{<div class="upcoming-list">@foreach(var item in Model.UpcomingLessons){<a asp-controller="Lessons" asp-action="Details" asp-route-id="@item.Id"><time><strong>@item.Lesson.StartDate.ToString("dd")</strong><small>@item.Lesson.StartDate.ToString("MMM")</small></time><div><strong>@item.Lesson.Title</strong><small>@item.Lesson.StartDate.ToString("HH:mm") · @item.Lesson.Subject</small></div><span>→</span></a>}</div>}</section><aside><div class="student-panel-head"><h2>Yaklaşan Ödevlerim</h2><a asp-controller="Assignments" asp-action="Index">Tümü →</a></div>@if(Model.UpcomingAssignments.Count==0){<div class="dashboard-empty compact"><div class="dashboard-empty-icon">✓</div><h3>Bekleyen ödev yok</h3><p>Yeni ödevler burada listelenecek.</p></div>}else{<div class="upcoming-list">@foreach(var item in Model.UpcomingAssignments){<a asp-controller="Assignments" asp-action="Details" asp-route-id="@item.Id"><time><strong>@item.DueDate.ToString("dd")</strong><small>@item.DueDate.ToString("MMM")</small></time><div><strong>@item.Assignment.Title</strong><small>@item.Assignment.Subject · @item.Status.ToTurkish()</small></div><span>→</span></a>}</div>}</aside></div>
<div class="student-dashboard-three"><section><div class="student-panel-head"><h2>Son Duyurular</h2><a asp-controller="Announcements" asp-action="Index">Tümü →</a></div>@foreach(var item in Model.RecentAnnouncements){<a class="student-feed-item" asp-controller="Announcements" asp-action="Details" asp-route-id="@item.Id"><small>@item.PublishDate.ToString("dd MMMM")</small><strong>@item.Title</strong><span>→</span></a>}@if(Model.RecentAnnouncements.Count==0){<p class="student-feed-empty">Yeni duyuru bulunmuyor.</p>}</section><section><div class="student-panel-head"><h2>Son Dokümanlar</h2><a asp-controller="Documents" asp-action="Index">Tümü →</a></div>@foreach(var item in Model.RecentDocuments){<a class="student-feed-item" asp-controller="Documents" asp-action="Download" asp-route-id="@item.Id"><small>@item.Category</small><strong>@item.Title</strong><span>↓</span></a>}@if(Model.RecentDocuments.Count==0){<p class="student-feed-empty">Paylaşılan doküman bulunmuyor.</p>}</section><section><div class="student-panel-head"><h2>Öğretmen Geri Bildirimleri</h2><a asp-controller="Assignments" asp-action="Index" asp-route-scope="completed">Ödevler →</a></div>@foreach(var item in Model.RecentFeedback){<a class="student-feed-item feedback" asp-controller="Assignments" asp-action="Details" asp-route-id="@item.Id"><small>@item.Assignment.Title · @(item.Score?.ToString()??"—") puan</small><strong>@item.TeacherFeedback</strong><span>→</span></a>}@if(Model.RecentFeedback.Count==0){<p class="student-feed-empty">Henüz geri bildirim bulunmuyor.</p>}</section></div>
