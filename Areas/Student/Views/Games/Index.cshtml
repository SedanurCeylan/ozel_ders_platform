@model GamesHomeViewModel
@{ ViewData["Title"]="Matematik Oyunları"; }
<div class="games-hero"><div><span>OYNA · ÖĞREN · GELİŞ</span><h1>Matematik Oyunları</h1><p>Hızını, doğruluğunu ve problem çözme gücünü geliştir.</p></div><div class="games-stats"><b>@Model.TotalGames<small>Oyun</small></b><b>@Model.TotalScore<small>Toplam puan</small></b><b>%@Model.Accuracy<small>Doğruluk</small></b></div></div>
<div class="game-cards two-games"><article class="game-card arena"><div class="game-icon">×÷</div><span>HIZ VE DİKKAT</span><h2>İşlem Arenası</h2><p>Süreye karşı işlemleri çöz, doğru serileri oluştur ve kendi rekorunu geç.</p><ul><li>5–8. sınıf</li><li>30–60 saniye</li><li>Adaptif zorluk</li></ul><button type="button" class="game-start" data-bs-toggle="modal" data-bs-target="#arenaSetup">Oyuna Başla →</button></article><article class="game-card locked"><div class="game-icon">△</div><span>YAKINDA</span><h2>Geometri Kaşifi</h2><p>Şekilleri incele, ölçümleri hesapla ve keşif görevlerini tamamla.</p><ul><li>Görsel görevler</li><li>İpucu sistemi</li></ul><button disabled>Yakında</button></article></div>
<section class="game-history"><h2>Son Oyunlarım</h2>@if(Model.RecentSessions.Count==0){<p class="game-empty">Henüz tamamlanmış oyunun yok. İlk puanını kazanmak için bir oyun seç!</p>}else{<div class="game-history-list">@foreach(var item in Model.RecentSessions){<a asp-action="Result" asp-route-id="@item.Id"><strong>İşlem Arenası</strong><span>@item.Topic · @item.GradeLevel. sınıf</span><b>@item.TotalScore puan</b><small>@item.CompletedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></a>}</div>}</section>
<div class="modal fade" id="arenaSetup" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form asp-action="StartArena" method="post" class="modal-content game-setup"><div class="modal-header"><div><small>İŞLEM ARENASI</small><h2>Oyununu hazırla</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="speed-note">⚡ İlk 3 saniyede doğru cevap: <strong>+50 hız bonusu</strong></div><label>Sınıf seviyesi<select name="grade" id="gameGrade">@for(var grade=5;grade<=8;grade++){<option value="@grade" selected="@(Model.DefaultGrade==grade)">@grade. sınıf</option>}</select></label><label>Konu<select name="topic"><option>Karışık</option><option>Dört İşlem</option><option>Problemler</option><option>Ondalık Sayılar</option><option>Yüzdeler</option><option>Üslü İfadeler</option></select></label><label>Zorluk<select name="difficulty"><option value="Easy">Kolay</option><option value="Medium" selected>Orta</option><option value="Hard">Zor</option></select></label><label>Oyun süresi<select name="durationSeconds"><option value="30">30 saniye · Sprint</option><option value="45" selected>45 saniye · Hızlı</option><option value="60">60 saniye · Klasik</option></select></label></div><div class="modal-footer"><button type="button" data-bs-dismiss="modal">Vazgeç</button><button class="game-start">Arenaya Gir →</button></div></form></div></div>
