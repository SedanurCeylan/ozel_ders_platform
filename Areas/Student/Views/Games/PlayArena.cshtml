@{ ViewData["Title"]="İşlem Arenası"; var q=(GameQuestionDto)ViewBag.Question; }
@Html.AntiForgeryToken()
<div class="arena-shell" data-session="@ViewBag.SessionId" data-end="@ViewBag.EndUnixMs"><header class="arena-top"><a asp-action="Index">← Çık</a><div><span>KALAN SÜRE</span><strong id="timer">--</strong></div><div><span>PUAN</span><strong id="score">0</strong></div><div><span>DOĞRU</span><strong id="correct">0</strong></div><div><span>YANLIŞ</span><strong id="wrong">0</strong></div><div><span>SERİ</span><strong id="streak">0</strong></div></header><div class="arena-progress"><span id="studentProgress"></span><i id="opponentProgress"></i></div><main class="arena-question"><small id="questionNumber">SORU @q.Number</small><h1 id="questionText">@q.Text</h1><div id="answerArea" class="answer-grid">@foreach(var option in q.Options){<button type="button" data-answer="@option">@option</button>}</div><div id="feedback" aria-live="polite"></div></main></div>
<script>window.arenaQuestion=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(q,new System.Text.Json.JsonSerializerOptions{PropertyNamingPolicy=System.Text.Json.JsonNamingPolicy.CamelCase}));</script>
@section Scripts { <script src="~/js/operation-arena.js" asp-append-version="true"></script> }
