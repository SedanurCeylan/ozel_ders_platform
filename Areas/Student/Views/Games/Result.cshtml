@model GameResultViewModel
@{ ViewData["Title"]="Oyun Sonucu"; var s=Model.Session; }
<div class="result-card"><span class="result-kicker">ARENA TAMAMLANDI</span><div class="result-medal">@(Model.IsNewRecord?"★":"✓")</div><h1>@(Model.IsNewRecord?"Yeni Rekor!":"Harika Mücadele!")</h1><strong class="result-score">@s.TotalScore <small>puan</small></strong><div class="result-metrics"><div><b>@s.CorrectAnswers</b><span>Doğru</span></div><div><b>@s.WrongAnswers</b><span>Yanlış</span></div><div><b>%@s.AccuracyPercentage</b><span>Başarı</span></div><div><b>@s.AverageAnswerTime sn</b><span>Ort. cevap</span></div><div><b>@s.LongestCorrectStreak</b><span>En uzun seri</span></div><div><b>@Model.PreviousBest</b><span>Önceki rekor</span></div></div><div class="result-actions"><form asp-action="StartArena" method="post"><input type="hidden" name="grade" value="@s.GradeLevel"/><input type="hidden" name="topic" value="@s.Topic"/><input type="hidden" name="difficulty" value="@s.DifficultyLevel"/><input type="hidden" name="durationSeconds" value="@(s.DurationSeconds is 30 or 45 or 60?s.DurationSeconds:45)"/><button class="game-start">Yeniden Oyna</button></form><a asp-action="Index">Oyunlara Dön</a></div>@if(s.Answers.Any(x=>!x.IsCorrect)){<section class="wrong-review"><h2>Yanlışları İncele</h2>@foreach(var answer in s.Answers.Where(x=>!x.IsCorrect)){<article><strong>@answer.GameQuestion.QuestionText</strong><p>Senin cevabın: @answer.StudentAnswer · Doğru cevap: @answer.GameQuestion.CorrectAnswer</p><small>@answer.GameQuestion.Explanation</small></article>}</section>}</div>
