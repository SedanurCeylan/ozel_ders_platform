@model StudentProgressViewModel
@{ ViewData["Title"]="Gelişimim"; }
<div class="student-page-title"><span>Akademik yolculuğum</span><h1>Gelişimim</h1><p>Deneme sonuçlarınızı ve konu bazlı ilerlemenizi takip edin.</p></div><div class="progress-summary"><article><small>Son net</small><strong>@(Model.ExamResults.LastOrDefault()?.NetScore.ToString("0.##") ?? "—")</strong></article><article><small>En yüksek net</small><strong>@(Model.ExamResults.Count>0?Model.ExamResults.Max(x=>x.NetScore).ToString("0.##"):"—")</strong></article><article><small>Tamamlanan konu</small><strong>@Model.ProgressRecords.Count(x=>x.ProgressStatus==ProgressStatus.Completed)</strong></article><article><small>Ortalama başarı</small><strong>%@(Model.ProgressRecords.Count>0?Model.ProgressRecords.Average(x=>x.SuccessPercentage).ToString("0"):"0")</strong></article></div><div class="student-grid"><section><h2>Net Değişimim</h2><canvas id="studentExamChart"></canvas><div class="progress-list">@foreach(var item in Model.ExamResults.OrderByDescending(x=>x.ExamDate).Take(5)){<article><div><strong>@item.ExamName</strong><small>@item.ExamDate.ToString("dd.MM.yyyy") · @item.TeacherComment</small></div><b>@item.NetScore.ToString("0.##") net</b></article>}</div></section><aside><h2>Konu Gelişimim</h2><div class="progress-list">@foreach(var item in Model.ProgressRecords){<article><div><strong>@item.Topic</strong><small>@item.StatusName</small><span><i style="width:@item.SuccessPercentage%"></i></span></div><b>%@item.SuccessPercentage</b></article>}</div></aside></div>
@section Scripts { <script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>new Chart(document.getElementById('studentExamChart'),{type:'line',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExamResults.Select(x=>x.ExamDate.ToString("dd.MM.yyyy")))),datasets:[{label:'Net',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExamResults.Select(x=>x.NetScore))),borderColor:'#ee735b',backgroundColor:'rgba(238,115,91,.12)',fill:true,tension:.3}]},options:{responsive:true,plugins:{legend:{display:false}}}});</script> }
