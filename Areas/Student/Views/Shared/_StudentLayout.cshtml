@using Microsoft.EntityFrameworkCore
@inject OzelDersYonetim.Data.ApplicationDbContext StudentLayoutDb
@{var studentSiteSettings=await StudentLayoutDb.SiteSettings.AsNoTracking().SingleAsync();}
<!DOCTYPE html>
<html lang="tr">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] | @studentSiteSettings.SiteName Öğrenci Paneli</title><link rel="icon" type="image/svg+xml" href="~/favicon-sigma.svg" asp-append-version="true"/><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/student.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/lessons.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/assignments.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/documents.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/progress.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/student-dashboard.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/dashboard-empty.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/profile-images.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/games.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/testimonials.css" asp-append-version="true"/></head>
<body>
<aside class="student-sidebar"><a class="student-brand" asp-area="Student" asp-controller="Dashboard" asp-action="Index"><span>∑</span><div>@studentSiteSettings.SiteName<small>Öğrenci Paneli</small></div></a><nav><a asp-area="Student" asp-controller="Dashboard" asp-action="Index">⌂ Panelim</a><a asp-area="Student" asp-controller="Dashboard" asp-action="Profile">♙ Profilim</a><a asp-area="Student" asp-controller="Lessons" asp-action="Index">◷ Derslerim</a><a asp-area="Student" asp-controller="Assignments" asp-action="Index">✓ Ödevlerim</a><a asp-area="Student" asp-controller="Games" asp-action="Index">◆ Matematik Oyunları</a><a asp-area="Student" asp-controller="Documents" asp-action="Index">▤ Dokümanlarım</a><a asp-area="Student" asp-controller="Announcements" asp-action="Index">◉ Duyurular</a><a asp-area="Student" asp-controller="Progress" asp-action="Index">↗ Gelişimim</a><a asp-area="Student" asp-controller="Testimonial" asp-action="Index">★ Yorumum</a><a asp-area="Student" asp-controller="Notifications" asp-action="Index">● Bildirimler</a></nav><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post"><button>Çıkış Yap</button></form></aside>
<main class="student-main"><header><button onclick="document.body.classList.toggle('menu-open')">☰</button><span>Öğrenci Paneli</span><a asp-area="" asp-controller="Home" asp-action="Index">Siteye git ↗</a></header><div class="student-content">@if(TempData["Success"] is string success){<div class="student-alert">✓ @success</div>}@RenderBody()</div></main>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
