@model AssignmentSubmissionViewModel
@{ ViewData["Title"] = "Ödev Ayrıntıları"; var item = Model.StudentAssignment; }
<div class="student-page-title"><span>@item.Assignment.Subject · @item.Status.ToTurkish()</span><h1>@item.Assignment.Title</h1><p>@item.Assignment.ShortDescription</p></div><div class="student-grid"><section><h2>Ödev açıklaması</h2><p>@item.Assignment.Description</p><dl><dt>Son teslim</dt><dd>@item.DueDate.ToString("dd MMMM yyyy HH:mm")</dd><dt>Maksimum puan</dt><dd>@item.Assignment.MaximumScore</dd><dt>Durum</dt><dd>@item.Status.ToTurkish()</dd></dl>@if(!string.IsNullOrWhiteSpace(item.Assignment.AttachmentPath)){<a class="join-lesson" href="@item.Assignment.AttachmentPath" download>Ödev ekini indir ↓</a>}@if(item.Score.HasValue){<div class="feedback-box"><strong>Puanınız: @item.Score / @item.Assignment.MaximumScore</strong><p>@item.TeacherFeedback</p></div>}</section><aside><h2>Ödevini teslim et</h2><form asp-action="Submit" asp-route-id="@item.Id" method="post" enctype="multipart/form-data" class="submission-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div>@if(item.Assignment.AllowStudentComment){<label>Açıklamanız</label><textarea asp-for="StudentDescription" rows="5"></textarea>}@if(item.Assignment.AllowFileUpload){<label>Dosyanız</label><input asp-for="File" type="file" accept=".pdf,.jpg,.jpeg,.png,.docx"/><small>PDF, JPG, PNG veya DOCX; en fazla 20 MB.</small>}<button class="join-lesson" type="submit">Ödevi Teslim Et →</button></form><div class="submission-history"><h3>Önceki teslimler</h3>@foreach(var submission in item.Submissions.OrderByDescending(x=>x.SubmissionNumber)){<p><strong>@submission.SubmissionNumber. teslim</strong> · @submission.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") @if(!string.IsNullOrWhiteSpace(submission.FilePath)){<a href="@submission.FilePath" download>Dosya</a>}</p>}</div></aside></div>
