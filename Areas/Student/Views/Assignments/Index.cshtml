@model IReadOnlyList<StudentAssignment>
@{ ViewData["Title"] = "Ödevlerim"; }
<div class="student-page-title"><span>Çalışma planım</span><h1>Ödevlerim</h1><p>Aktif, geciken ve değerlendirilen ödevlerinizi takip edin.</p></div><div class="student-filter"><a class="@(ViewBag.Scope is null ? "active" : "")" asp-action="Index">Aktif ödevler</a><a class="@(ViewBag.Scope == "late" ? "active" : "")" asp-route-scope="late">Gecikenler</a><a class="@(ViewBag.Scope == "completed" ? "active" : "")" asp-route-scope="completed">Değerlendirilenler</a></div><div class="student-lesson-list">@if(Model.Count == 0){<div class="student-empty">Bu görünümde ödev bulunmuyor.</div>}@foreach(var item in Model){<a asp-action="Details" asp-route-id="@item.Id"><time><strong>@item.DueDate.ToString("dd")</strong><small>@item.DueDate.ToString("MMM")</small></time><div><span>@item.Status.ToTurkish()</span><h2>@item.Assignment.Title</h2><p>@item.Assignment.Subject · Son teslim @item.DueDate.ToString("dd.MM.yyyy HH:mm")</p></div><b>→</b></a>}</div>
