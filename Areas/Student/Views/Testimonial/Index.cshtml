@model StudentTestimonial
@{ViewData["Title"]="Yorumum";}
<div class="student-page-heading"><div><span>DENEYİMİNİ PAYLAŞ</span><h1>Yorumum</h1><p>Ders deneyimini kendi sözlerinle anlat. Yorumun yönetici onayından sonra ana sayfada gösterilir.</p></div></div>
<div class="testimonial-editor-shell"><form method="post" class="testimonial-editor"><input asp-for="Id" type="hidden"/><input asp-for="StudentProfileId" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="testimonial-status @(Model.Id==0?"new":Model.IsActive?"published":"waiting")"><span>@(Model.Id==0?"✎":Model.IsActive?"✓":"◷")</span><div><strong>@(Model.Id==0?"Henüz yorum eklemedin":Model.IsActive?"Yorumun yayında":"Yorumun onay bekliyor")</strong><small>@(Model.IsActive?"Ana sayfada ziyaretçilere gösteriliyor.":"Yönetici yayınladıktan sonra ana sayfada görünecek.")</small></div></div><label asp-for="Comment"></label><textarea asp-for="Comment" rows="8" maxlength="1000" placeholder="Matematik dersleri veya öğretmenin yaklaşımı sana nasıl yardımcı oldu?"></textarea><span asp-validation-for="Comment" class="text-danger"></span><fieldset><legend>Ders deneyimine kaç puan verirsin?</legend><div class="rating-options">@for(var rating=5;rating>=1;rating--){<label><input asp-for="Rating" type="radio" value="@rating"/><span>@rating ★</span></label>}</div><span asp-validation-for="Rating" class="text-danger"></span></fieldset><p class="privacy-note">Sitede yalnızca adın, soyadının baş harfi ve sınıf seviyen gösterilir.</p><button type="submit">@(Model.Id==0?"Yorumu Gönder":"Yorumu Güncelle") →</button></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
