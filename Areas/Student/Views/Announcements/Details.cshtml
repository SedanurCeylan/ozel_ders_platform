@model Announcement
@{ViewData["Title"]=Model.Title;}
<div class="student-page-title"><span>@Model.PublishDate.ToString("dd MMMM yyyy")</span><h1>@Model.Title</h1><p>Öğretmen duyurusu</p></div><article class="announcement-detail">@foreach(var paragraph in Model.Content.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<p>@paragraph</p>}@if(!string.IsNullOrWhiteSpace(Model.AttachmentPath)){<a class="join-lesson" asp-action="Download" asp-route-id="@Model.Id">Duyuru ekini indir ↓</a>}<a asp-action="Index">← Tüm duyurular</a></article>
