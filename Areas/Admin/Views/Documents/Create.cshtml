@model DocumentFormViewModel
@{ ViewData["Title"] = "Yeni Doküman"; }
<div class="page-heading"><div><span>Doküman paylaşımı</span><h1>Yeni Doküman</h1><p>Dosyanın kimler tarafından görüntülenebileceğini belirleyin.</p></div></div>
<form method="post" enctype="multipart/form-data" class="admin-form"><div asp-validation-summary="All" class="text-danger form-validation-summary"></div><section class="form-card"><div class="form-grid"><div class="wide"><label asp-for="Document.Title"></label><input asp-for="Document.Title"/><span asp-validation-for="Document.Title"></span></div><div class="wide"><label asp-for="Document.Description"></label><textarea asp-for="Document.Description" rows="4"></textarea></div><div><label asp-for="Document.Category"></label><input asp-for="Document.Category" placeholder="Örn. Konu Anlatımı"/></div><div><label asp-for="Document.AccessType"></label><select asp-for="Document.AccessType"><option value="Public">Herkese açık</option><option value="AllStudents">Tüm öğrencilere açık</option><option value="SelectedStudents">Seçili öğrencilere özel</option></select></div><div class="wide"><label asp-for="SelectedStudentIds">Paylaşılacak öğrenciler</label><select asp-for="SelectedStudentIds" asp-items="Model.Students" multiple size="7"></select><small>“Seçili öğrencilere özel” erişimi için öğrenci seçin.</small></div><div class="wide"><label asp-for="File">Dosya</label><input asp-for="File" type="file" accept=".pdf,.jpg,.jpeg,.png,.docx"/><span asp-validation-for="File"></span><small>PDF, JPG, PNG veya DOCX; en fazla 20 MB.</small></div><div class="check-field"><input asp-for="Document.IsActive"/><label asp-for="Document.IsActive"></label></div></div></section><div class="form-actions"><a class="admin-btn" asp-action="Index">Vazgeç</a><button class="admin-btn primary" type="submit">Dokümanı Paylaş</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
