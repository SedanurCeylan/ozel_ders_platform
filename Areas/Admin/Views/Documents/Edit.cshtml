@model DocumentFormViewModel
@{ViewData["Title"]="Dokümanı Düzenle";}
<div class="page-heading"><div><span>Doküman yönetimi</span><h1>Dokümanı Düzenle</h1><p>Başlık, kategori ve öğrenci erişimlerini güncelleyin.</p></div></div><form method="post" class="admin-form"><input asp-for="Document.Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><section class="form-card"><div class="form-grid"><div class="wide"><label asp-for="Document.Title"></label><input asp-for="Document.Title"/><span asp-validation-for="Document.Title"></span></div><div class="wide"><label asp-for="Document.Description"></label><textarea asp-for="Document.Description" rows="4"></textarea></div><div><label asp-for="Document.Category"></label><input asp-for="Document.Category"/></div><div><label asp-for="Document.AccessType"></label><select asp-for="Document.AccessType"><option value="Public">Herkese açık</option><option value="AllStudents">Tüm öğrencilere açık</option><option value="SelectedStudents">Seçili öğrencilere özel</option></select></div><div class="wide"><label asp-for="SelectedStudentIds">Paylaşılacak öğrenciler</label><select asp-for="SelectedStudentIds" asp-items="Model.Students" multiple size="8"></select><span asp-validation-for="SelectedStudentIds"></span><small>Görüntüleme veya indirme geçmişi olan erişim kayıtları silinmez.</small></div><div class="check-field"><input asp-for="Document.IsActive"/><label asp-for="Document.IsActive"></label></div><div class="wide"><p class="form-note">Yüklü dosya: <strong>@Model.Document.OriginalFileName</strong>. Dosyanın kendisi değiştirilmez; yeni sürüm için yeni doküman yükleyin.</p></div></div></section><div class="form-actions"><a class="admin-btn" asp-action="Index">Vazgeç</a><button class="admin-btn primary">Değişiklikleri Kaydet</button></div></form>
