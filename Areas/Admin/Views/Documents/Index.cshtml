@model IReadOnlyList<CourseDocument>
@{ ViewData["Title"] = "Dokümanlar"; }
<div class="page-heading"><div><span>Kaynak yönetimi</span><h1>Tüm Dokümanlar</h1><p>PDF ve çalışma dosyalarını öğrencilerle güvenli şekilde paylaşın.</p></div><a class="admin-btn primary" asp-action="Create">+ Yeni doküman</a></div>
<div class="filter-row"><a class="@(ViewBag.Category is null ? "active" : "")" asp-action="Index">Tümü</a>@foreach(string category in ViewBag.Categories){<a class="@(ViewBag.Category == category ? "active" : "")" asp-route-category="@category">@category</a>}</div>
<div class="table-card"><div class="responsive-table"><table><thead><tr><th>Doküman</th><th>Kategori</th><th>Erişim</th><th>Boyut</th><th>İndiren</th><th>Durum</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="7" class="empty-state">Henüz doküman yüklenmemiş.</td></tr>}@foreach(var item in Model){<tr><td><strong>@item.Title</strong><small>@item.OriginalFileName</small></td><td>@item.Category</td><td>@item.AccessName</td><td>@((item.FileSize / 1024d / 1024d).ToString("0.##")) MB</td><td>@item.StudentDocuments.Count(x=>x.IsDownloaded)</td><td><span class="status-pill @(item.IsActive?"on":"off")">@(item.IsActive?"Aktif":"Pasif")</span></td><td class="actions"><a asp-action="Download" asp-route-id="@item.Id">İndir</a><a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a><form asp-action="Toggle" asp-route-id="@item.Id" method="post"><button>@(item.IsActive?"Pasif yap":"Aktif yap")</button></form><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Doküman erişime kapatılsın mı?')"><button>Kaldır</button></form></td></tr>}</tbody></table></div></div>
