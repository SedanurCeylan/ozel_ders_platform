@model IReadOnlyList<StudentTestimonial>
@{ViewData["Title"]="Öğrenci Yorumları";}
<div class="page-heading"><div><span>Gerçek öğrenci deneyimleri</span><h1>Öğrenci Yorumları</h1><p>Öğrencilerin kendi hesaplarından gönderdiği yorumları inceleyin. Metin değiştirilemez; yalnızca yayın durumu yönetilebilir.</p></div></div>
<div class="testimonial-admin-list">@if(Model.Count==0){<div class="empty-state">Henüz öğrenci yorumu gönderilmedi.</div>}@foreach(var item in Model){<article><div class="testimonial-admin-person"><span>@item.StudentProfile.FirstName[0]@item.StudentProfile.LastName[0]</span><div><strong>@item.StudentProfile.FullName</strong><small>@item.StudentProfile.GradeLevel · @item.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></div></div><div class="testimonial-stars">@string.Concat(Enumerable.Repeat("★",item.Rating))@string.Concat(Enumerable.Repeat("☆",5-item.Rating))</div><blockquote>“@item.Comment”</blockquote><footer><span class="status-pill @(item.IsActive?"on":"off")">@(item.IsActive?"Yayında":"Onay bekliyor / Pasif")</span><form asp-action="Toggle" asp-route-id="@item.Id" method="post"><button class="admin-btn @(item.IsActive?"danger-soft":"primary")">@(item.IsActive?"Pasif Yap":"Yayınla")</button></form></footer></article>}</div>
