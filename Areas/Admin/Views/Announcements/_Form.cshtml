@model AnnouncementFormViewModel
<div class="form-grid"><div class="wide"><label asp-for="Announcement.Title"></label><input asp-for="Announcement.Title"/><span asp-validation-for="Announcement.Title"></span></div><div class="wide"><label asp-for="Announcement.Content"></label><textarea asp-for="Announcement.Content" rows="8"></textarea><span asp-validation-for="Announcement.Content"></span></div><div><label asp-for="Announcement.TargetType"></label><select asp-for="Announcement.TargetType"><option value="AllStudents">Tüm öğrenciler</option><option value="GradeLevel">Sınıf seviyesi</option><option value="SelectedStudents">Seçili öğrenciler</option></select></div><div><label asp-for="Announcement.GradeLevel"></label><input asp-for="Announcement.GradeLevel" placeholder="Örn. 8. Sınıf"/><span asp-validation-for="Announcement.GradeLevel"></span></div><div class="wide"><label asp-for="SelectedStudentIds">Hedef öğrenciler</label><select asp-for="SelectedStudentIds" asp-items="Model.Students" multiple size="7"></select><span asp-validation-for="SelectedStudentIds"></span><small>Seçili öğrencilere özel duyuru için kullanılır.</small></div><div><label asp-for="Announcement.PublishDate"></label><input asp-for="Announcement.PublishDate" type="datetime-local"/></div><div><label asp-for="Announcement.ExpiryDate"></label><input asp-for="Announcement.ExpiryDate" type="datetime-local"/></div><div class="wide"><label asp-for="Attachment">PDF veya görsel eki</label><input asp-for="Attachment" type="file" accept=".pdf,.jpg,.jpeg,.png"/><small>PDF, JPG veya PNG; en fazla 20 MB. Yeni dosya seçmezseniz mevcut ek korunur.</small></div><div class="check-field"><input asp-for="Announcement.SendEmail"/><label asp-for="Announcement.SendEmail"></label></div><div class="check-field"><input asp-for="Announcement.IsActive"/><label asp-for="Announcement.IsActive"></label></div></div>
