@model IReadOnlyList<Announcement>
@{ViewData["Title"]="Duyurular";}
<div class="page-heading"><div><span>İletişim</span><h1>Duyurular</h1><p>Öğrencilere duyuru ve bildirim yayınlayın.</p></div><a class="admin-btn primary" asp-action="Create">+ Yeni duyuru</a></div><div class="table-card"><div class="responsive-table"><table><thead><tr><th>Duyuru</th><th>Hedef</th><th>Yayın</th><th>Bitiş</th><th>Okuyan</th><th>Durum</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="7" class="empty-state">Henüz duyuru bulunmuyor.</td></tr>}@foreach(var item in Model){<tr><td><strong>@item.Title</strong><small>@(item.Content.Length>80?item.Content[..80]+"…":item.Content)</small></td><td>@item.TargetName</td><td>@item.PublishDate.ToString("dd.MM.yyyy HH:mm")</td><td>@(item.ExpiryDate?.ToString("dd.MM.yyyy")??"Süresiz")</td><td>@item.AnnouncementStudents.Count(x=>x.IsViewed) / @item.AnnouncementStudents.Count</td><td><span class="status-pill @(item.IsActive?"on":"off")">@(item.IsActive?"Aktif":"Pasif")</span></td><td class="actions"><a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>@if(!string.IsNullOrWhiteSpace(item.AttachmentPath)){<a asp-action="Download" asp-route-id="@item.Id">Ek</a>}<form asp-action="Toggle" asp-route-id="@item.Id" method="post"><button>@(item.IsActive?"Pasif yap":"Aktif yap")</button></form><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Duyuru yayından kaldırılsın mı?')"><button>Kaldır</button></form></td></tr>}</tbody></table></div></div>
