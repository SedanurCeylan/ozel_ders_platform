@model AdminDashboardViewModel
@{ ViewData["Title"] = "Genel Bakış"; }
<div class="page-heading"><div><span>@DateTime.Now.ToString("dd MMMM yyyy")</span><h1>İyi günler, Öğretmen 👋</h1><p>Öğrencilerinizin ve ders çalışmalarının güncel özeti.</p></div><div class="dashboard-actions"><a class="admin-btn" asp-controller="Lessons" asp-action="Create">+ Ders</a><a class="admin-btn" asp-controller="Assignments" asp-action="Create">+ Ödev</a><a class="admin-btn primary" asp-controller="Students" asp-action="Create">+ Öğrenci</a></div></div>

<div class="stat-grid dashboard-stats">
    <article><span class="stat-icon coral">♙</span><div><small>Toplam öğrenci</small><strong>@Model.TotalStudents</strong><em>@Model.ActiveStudents aktif</em></div></article>
    <article><span class="stat-icon green">✓</span><div><small>Aktif öğrenci</small><strong>@Model.ActiveStudents</strong><em>@Model.PassiveStudents pasif</em></div></article>
    <article><span class="stat-icon blue">◷</span><div><small>Bugünkü ders</small><strong>@Model.TodayLessons</strong><em>@Model.UpcomingLessons yaklaşan</em></div></article>
    <article><span class="stat-icon gold">☷</span><div><small>Bu ay ders</small><strong>@Model.MonthlyLessons</strong><em>Tamamı</em></div></article>
    <article><span class="stat-icon coral">✓</span><div><small>Bekleyen ödev</small><strong>@Model.PendingAssignments</strong><em>Aktif atama</em></div></article>
    <article><span class="stat-icon gold">!</span><div><small>Geciken ödev</small><strong>@Model.LateAssignments</strong><em>Teslim edilmedi</em></div></article>
    <article><span class="stat-icon blue">✎</span><div><small>Değerlendirme</small><strong>@Model.AwaitingEvaluation</strong><em>Teslim alındı</em></div></article>
    <article><span class="stat-icon green">▤</span><div><small>Doküman</small><strong>@Model.TotalDocuments</strong><em>Aktif paylaşım</em></div></article>
    <article><span class="stat-icon coral">✉</span><div><small>E-posta hatası</small><strong>@Model.FailedEmails</strong><em>Kontrol edilmeli</em></div></article>
    <article><span class="stat-icon gold">◉</span><div><small>Okunmamış duyuru</small><strong>@Model.UnreadAnnouncements</strong><em>Öğrenci görüntülemesi</em></div></article>
</div>

<div class="dashboard-wide-grid">
    <section class="admin-panel"><div class="panel-head"><div><h2>Bugünün Ders Programı</h2><p>@DateTime.Now.ToString("dd MMMM dddd")</p></div><a asp-controller="Lessons" asp-action="Index" asp-route-scope="today">Takvimi aç →</a></div>@if(Model.TodaySchedule.Count==0){<div class="dashboard-empty">Bugün planlanmış ders bulunmuyor.</div>}else{<div class="dashboard-list">@foreach(var lesson in Model.TodaySchedule){<a asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson.Id"><time>@lesson.StartDate.ToString("HH:mm")</time><div><strong>@lesson.Title</strong><small>@string.Join(", ",lesson.StudentLessons.Select(x=>x.StudentProfile.FullName)) · @lesson.LessonMode.ToTurkish()</small></div><span class="status-pill on">@lesson.Status.ToTurkish()</span></a>}</div>}</section>
    <section class="admin-panel"><div class="panel-head"><div><h2>Son Eklenen Öğrenciler</h2><p>Yeni kayıtlar</p></div><a asp-controller="Students" asp-action="Index">Tümünü gör →</a></div><div class="dashboard-list">@foreach(var student in Model.RecentStudents){<a asp-controller="Students" asp-action="Details" asp-route-id="@student.Id"><span class="mini-avatar">@student.FirstName[0]@student.LastName[0]</span><div><strong>@student.FullName</strong><small>@student.GradeLevel · @student.RegistrationDate.ToString("dd.MM.yyyy")</small></div><span class="status-pill @(student.IsActive?"on":"off")">@(student.IsActive?"Aktif":"Pasif")</span></a>}</div></section>
</div>

<div class="dashboard-three-grid">
    <section class="admin-panel"><div class="panel-head"><div><h2>Yaklaşan Ödevler</h2><p>Son teslim tarihleri</p></div><a asp-controller="Assignments" asp-action="Index">Ödevler →</a></div><div class="dashboard-list compact">@foreach(var item in Model.UpcomingAssignmentDeadlines){<a asp-controller="Assignments" asp-action="Details" asp-route-id="@item.AssignmentId"><time>@item.DueDate.ToString("dd MMM")</time><div><strong>@item.Assignment.Title</strong><small>@item.StudentProfile.FullName · @item.DueDate.ToString("HH:mm")</small></div></a>}@if(Model.UpcomingAssignmentDeadlines.Count==0){<div class="dashboard-empty">Yaklaşan teslim bulunmuyor.</div>}</div></section>
    <section class="admin-panel"><div class="panel-head"><div><h2>Son Teslimler</h2><p>Öğrenci çalışmaları</p></div><a asp-controller="Assignments" asp-action="Index" asp-route-scope="waiting">Değerlendir →</a></div><div class="dashboard-list compact">@foreach(var item in Model.RecentSubmissions){<a asp-controller="Assignments" asp-action="Details" asp-route-id="@item.StudentAssignment.AssignmentId"><span class="mini-avatar">✓</span><div><strong>@item.StudentAssignment.StudentProfile.FullName</strong><small>@item.StudentAssignment.Assignment.Title · @item.SubmittedAt.ToLocalTime().ToString("dd.MM HH:mm")</small></div></a>}@if(Model.RecentSubmissions.Count==0){<div class="dashboard-empty">Henüz teslim bulunmuyor.</div>}</div></section>
    <section class="admin-panel"><div class="panel-head"><div><h2>Son Deneme Sonuçları</h2><p>Net sonuçları</p></div><a asp-controller="Progress" asp-action="Index">Gelişim →</a></div><div class="dashboard-list compact">@foreach(var result in Model.RecentExamResults){<a asp-controller="Progress" asp-action="Index" asp-route-studentId="@result.StudentProfileId"><span class="mini-avatar">∑</span><div><strong>@result.StudentProfile.FullName</strong><small>@result.ExamName · @result.ExamDate.ToString("dd.MM.yyyy")</small></div><b>@result.NetScore.ToString("0.##") net</b></a>}@if(Model.RecentExamResults.Count==0){<div class="dashboard-empty">Deneme sonucu bulunmuyor.</div>}</div></section>
</div>

@if(Model.RecentEmailErrors.Count>0){<section class="admin-panel dashboard-errors"><div class="panel-head"><div><h2>E-posta Gönderim Hataları</h2><p>SMTP ayarlarını veya alıcı adreslerini kontrol edin.</p></div><a asp-controller="EmailLogs" asp-action="Index" asp-route-successful="false">Tüm hatalar →</a></div><div class="dashboard-list compact">@foreach(var error in Model.RecentEmailErrors){<a asp-controller="EmailLogs" asp-action="Details" asp-route-id="@error.Id"><span class="error-dot">!</span><div><strong>@error.RecipientEmail</strong><small>@error.Subject · @error.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></div><span>Detay →</span></a>}</div></section>}
