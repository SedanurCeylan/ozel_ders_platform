@model LessonFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Lesson.Id" type="hidden"/><input asp-for="Lesson.CreatedAt" type="hidden"/><div class="form-grid"><div class="wide"><label asp-for="Lesson.Title"></label><input asp-for="Lesson.Title"/><span asp-validation-for="Lesson.Title"></span></div><div><label asp-for="Lesson.Subject"></label><input asp-for="Lesson.Subject"/><span asp-validation-for="Lesson.Subject"></span></div><div><label asp-for="Lesson.Status"></label><select asp-for="Lesson.Status"><option value="Planned">Planlandı</option><option value="Confirmed">Onaylandı</option><option value="Completed">Tamamlandı</option><option value="TeacherCancelled">Öğretmen iptal etti</option><option value="StudentCancelled">Öğrenci iptal etti</option><option value="Postponed">Ertelendi</option></select></div><div><label asp-for="Lesson.StartDate"></label><input asp-for="Lesson.StartDate" type="datetime-local"/><span asp-validation-for="Lesson.StartDate"></span></div><div><label asp-for="Lesson.EndDate"></label><input asp-for="Lesson.EndDate" type="datetime-local"/><span asp-validation-for="Lesson.EndDate"></span></div><div><label asp-for="Lesson.LessonMode"></label><select asp-for="Lesson.LessonMode"><option value="Online">Çevrim içi</option><option value="FaceToFace">Yüz yüze</option></select></div><div><label asp-for="Lesson.OnlineMeetingUrl"></label><input asp-for="Lesson.OnlineMeetingUrl" placeholder="https://..."/><span asp-validation-for="Lesson.OnlineMeetingUrl"></span></div><div class="wide"><label asp-for="Lesson.Description"></label><textarea asp-for="Lesson.Description" rows="4"></textarea></div><div class="wide"><label asp-for="SelectedStudentIds"></label><select asp-for="SelectedStudentIds" asp-items="Model.Students" multiple size="6"></select><span asp-validation-for="SelectedStudentIds"></span><small>Birden fazla öğrenci seçmek için Komut veya Kontrol tuşunu kullanın.</small></div><div class="check-field"><input asp-for="Lesson.SendEmailNotification"/><label asp-for="Lesson.SendEmailNotification"></label></div><div class="wide"><label asp-for="Lesson.TeacherNote"></label><textarea asp-for="Lesson.TeacherNote" rows="4"></textarea></div><div class="wide"><label asp-for="Lesson.NextLessonTopic"></label><input asp-for="Lesson.NextLessonTopic"/></div></div>
