@model IReadOnlyList<EmailLog>
@{ViewData["Title"]="E-posta Geçmişi";}
<div class="page-heading"><div><span>Bildirim kayıtları</span><h1>E-posta Geçmişi</h1><p>Başarılı ve başarısız e-posta gönderimlerini inceleyin.</p></div></div><form class="student-filters" method="get"><input name="search" value="@ViewBag.Search" placeholder="E-posta veya konu ara"/><select name="successful"><option value="">Tüm durumlar</option><option value="true" selected="@(ViewBag.Successful==true)">Başarılı</option><option value="false" selected="@(ViewBag.Successful==false)">Başarısız</option></select><button class="admin-btn">Filtrele</button></form><div class="table-card"><div class="responsive-table"><table><thead><tr><th>Alıcı</th><th>Konu</th><th>Tür</th><th>Tarih</th><th>Durum</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="6" class="empty-state">E-posta kaydı bulunmuyor.</td></tr>}@foreach(var item in Model){<tr><td><strong>@item.RecipientName</strong><small>@item.RecipientEmail</small></td><td>@item.Subject</td><td>@item.EmailType</td><td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td><span class="status-pill @(item.IsSuccessful?"on":"off")">@(item.IsSuccessful?"Gönderildi":"Gönderilemedi")</span></td><td class="actions"><a asp-action="Details" asp-route-id="@item.Id">Detay</a></td></tr>}</tbody></table></div></div>
