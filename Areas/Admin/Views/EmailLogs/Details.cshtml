@model EmailLog
@{ViewData["Title"]="E-posta Ayrıntıları";}
<div class="page-heading"><div><span>@Model.EmailType</span><h1>@Model.Subject</h1><p>@Model.RecipientName · @Model.RecipientEmail</p></div><div><a class="admin-btn" asp-action="Index">← Geçmiş</a>@if(!Model.IsSuccessful){<form asp-action="Retry" asp-route-id="@Model.Id" method="post" class="inline-retry" onsubmit="return confirm('E-posta yeniden gönderilsin mi?')"><button class="admin-btn primary">Yeniden Gönder</button></form>}</div></div><div class="detail-grid"><section class="admin-panel"><h2>Gönderim Bilgileri</h2><dl><dt>Durum</dt><dd>@(Model.IsSuccessful?"Başarılı":"Başarısız")</dd><dt>Gönderim tarihi</dt><dd>@(Model.SentAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")??"—")</dd><dt>Hata</dt><dd>@(Model.ErrorMessage??"—")</dd></dl>@if(Model.EmailType is "Yeni öğrenci hesabı" or "Şifre sıfırlama"){<p class="form-note">Güvenlik nedeniyle geçici şifreler e-posta geçmişinde saklanmaz ve bu kayıt geçmişten yeniden gönderilemez.</p>}</section><section class="admin-panel"><h2>E-posta Önizlemesi</h2><iframe title="E-posta içeriği" srcdoc="@Model.Body" style="width:100%;min-height:500px;border:1px solid #ddd"></iframe></section></div>
