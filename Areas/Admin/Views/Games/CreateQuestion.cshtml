@model GameQuestion
@{ ViewData["Title"]="Yeni Oyun Sorusu"; }
<div class="page-heading"><div><span>Soru bankası</span><h1>Yeni Soru Ekle</h1><p>İlk sürümde İşlem Arenası için çoktan seçmeli sorular eklenir.</p></div></div><form method="post" class="admin-form"><div asp-validation-summary="All" class="text-danger"></div><section class="form-card"><div class="form-grid"><input asp-for="GameType" type="hidden" value="OperationArena"/><input asp-for="QuestionType" type="hidden" value="MultipleChoice"/><div><label asp-for="GradeLevel"></label><select asp-for="GradeLevel">@for(var g=5;g<=8;g++){<option value="@g">@g. sınıf</option>}</select></div><div><label asp-for="Topic"></label><input asp-for="Topic"/></div><div><label asp-for="DifficultyLevel"></label><select asp-for="DifficultyLevel"><option value="Easy">Kolay</option><option value="Medium">Orta</option><option value="Hard">Zor</option></select></div><div><label asp-for="TimeLimitSeconds"></label><input asp-for="TimeLimitSeconds"/></div><div class="wide"><label asp-for="QuestionText"></label><textarea asp-for="QuestionText" rows="3"></textarea></div><div><label>Seçenek A</label><input name="optionA"/></div><div><label>Seçenek B</label><input name="optionB"/></div><div><label>Seçenek C</label><input name="optionC"/></div><div><label>Seçenek D</label><input name="optionD"/></div><div><label asp-for="CorrectAnswer"></label><input asp-for="CorrectAnswer"/></div><div><label asp-for="Score"></label><input asp-for="Score"/></div><div class="wide"><label asp-for="Explanation"></label><textarea asp-for="Explanation" rows="4"></textarea></div><div class="check-field"><input asp-for="IsActive"/><label asp-for="IsActive"></label></div></div></section><div class="form-actions"><a class="admin-btn" asp-action="Questions">Vazgeç</a><button class="admin-btn primary">Soruyu Kaydet</button></div></form>
