@model IReadOnlyList<GameSession>
@{ ViewData["Title"]="Oyun Yönetimi"; }
<div class="page-heading"><div><span>Oyun yönetimi</span><h1>Öğrenci Skorları</h1><p>İşlem Arenası sonuçlarını ve şüpheli oturumları izleyin.</p></div><a class="admin-btn primary" asp-action="Questions">Soru Bankası</a></div>
<div class="game-admin-summary"><div><b>@Model.Count</b><span>Tamamlanan oyun</span></div><div><b>@Model.Sum(x=>x.TotalScore)</b><span>Toplam puan</span></div><div><b>%@(Model.Count==0?0:Math.Round(Model.Average(x=>x.AccuracyPercentage),1))</b><span>Ortalama doğruluk</span></div><div><b>@Model.Count(x=>x.IsSuspicious)</b><span>İncelenecek oturum</span></div></div>
<div class="table-card"><div class="responsive-table"><table><thead><tr><th>Öğrenci</th><th>Oyun</th><th>Sınıf / Konu</th><th>Puan</th><th>Doğru / Yanlış</th><th>Doğruluk</th><th>Süre</th><th>Tarih</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="9" class="empty-state">Henüz tamamlanmış oyun bulunmuyor.</td></tr>}@foreach(var item in Model){<tr><td><strong>@item.StudentProfile.FullName</strong>@if(item.IsSuspicious){<small class="text-danger">İncelenmeli</small>}</td><td>İşlem Arenası</td><td>@item.GradeLevel. sınıf<small>@item.Topic</small></td><td><strong>@item.TotalScore</strong></td><td>@item.CorrectAnswers / @item.WrongAnswers</td><td>%@item.AccuracyPercentage</td><td>@item.AverageAnswerTime sn</td><td>@item.CompletedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td><form asp-action="DeleteSession" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu oyun sonucu silinsin mi?')"><button>Sil</button></form></td></tr>}</tbody></table></div></div>
