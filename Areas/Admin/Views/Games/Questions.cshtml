@model IReadOnlyList<GameQuestion>
@{ ViewData["Title"]="Oyun Soru Bankası"; }
<div class="page-heading"><div><span>Ortak altyapı</span><h1>Soru Bankası</h1><p>Oyun sorularını sınıf, konu ve zorluk düzeyine göre yönetin.</p></div><a class="admin-btn primary" asp-action="CreateQuestion">+ Yeni soru</a></div><form method="get" class="student-filters"><select name="grade"><option value="">Tüm sınıflar</option>@for(var g=5;g<=8;g++){<option value="@g" selected="@(ViewBag.Grade==g)">@g. sınıf</option>}</select><input name="topic" value="@ViewBag.Topic" placeholder="Konu ara"/><button class="admin-btn">Filtrele</button></form>
<div class="table-card"><div class="responsive-table"><table><thead><tr><th>Sınıf</th><th>Konu</th><th>Soru</th><th>Zorluk</th><th>Puan</th><th>Durum</th><th></th></tr></thead><tbody>@foreach(var q in Model){<tr><td>@q.GradeLevel</td><td>@q.Topic</td><td><strong>@q.QuestionText</strong><small>@q.Explanation</small></td><td>@(q.DifficultyLevel==GameDifficulty.Easy?"Kolay":q.DifficultyLevel==GameDifficulty.Medium?"Orta":"Zor")</td><td>@q.Score</td><td><span class="status-pill @(q.IsActive?"on":"off")">@(q.IsActive?"Aktif":"Pasif")</span></td><td><form asp-action="ToggleQuestion" asp-route-id="@q.Id" method="post"><button>@(q.IsActive?"Pasif yap":"Aktif yap")</button></form></td></tr>}</tbody></table></div></div>
