@model IReadOnlyList<ContentSection>
@{ViewData["Title"]="Sınıf İçerikleri";}
<div class="page-heading"><div><span>Web sitesi yönetimi</span><h1>Sınıf İçerikleri</h1><p>Sitedeki sınıfları ve konu listelerini kod değiştirmeden yönetin.</p></div><a class="admin-btn primary" asp-action="Create">+ Yeni sınıf ekle</a></div>
<div class="table-card"><div class="responsive-table"><table><thead><tr><th>Sıra</th><th>Sınıf</th><th>Başlık</th><th>Konular</th><th>Durum</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="6" class="empty-state">Henüz sınıf içeriği yok. Yeni sınıf ekleyebilirsiniz.</td></tr>}@foreach(var item in Model){<tr><td>@item.DisplayOrder</td><td><strong>@item.Subtitle</strong></td><td>@item.Title</td><td><small>@item.Content.Replace("|"," · ")</small></td><td><span class="status-pill @(item.IsActive?"on":"off")">@(item.IsActive?"Yayında":"Gizli")</span></td><td class="actions"><a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a><form asp-action="Toggle" asp-route-id="@item.Id" method="post"><button>@(item.IsActive?"Gizle":"Yayınla")</button></form><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu sınıf ve tüm konu içeriği tamamen silinsin mi?')"><button class="text-danger">Sil</button></form></td></tr>}</tbody></table></div></div>
