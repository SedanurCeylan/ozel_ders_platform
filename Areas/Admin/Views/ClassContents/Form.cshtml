@model ClassContentViewModel
@{var edit=Model.Id>0;ViewData["Title"]=edit?"Sınıf İçeriğini Düzenle":"Yeni Sınıf Ekle";}
<div class="page-heading"><div><span>Sınıf içerikleri</span><h1>@ViewData["Title"]</h1><p>Sınıf adı ve konular doğrudan genel sitede gösterilir.</p></div></div><form method="post" class="admin-form"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><section class="form-card"><div class="form-grid"><div><label asp-for="GradeLabel"></label><input asp-for="GradeLabel" placeholder="Örn. 6. Sınıf"/><span asp-validation-for="GradeLabel"></span></div><div><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" type="number"/><span asp-validation-for="DisplayOrder"></span></div><div class="wide"><label asp-for="Title"></label><input asp-for="Title" placeholder="Örn. 6. Sınıf Matematik"/><span asp-validation-for="Title"></span></div><div class="wide"><label asp-for="Topics"></label><textarea asp-for="Topics" rows="10" placeholder="Her konuyu ayrı satıra yazın.&#10;Çarpanlar ve Katlar&#10;Tam Sayılar&#10;Oran"></textarea><small>Her satıra bir konu yazın. Virgül veya | işareti de kullanılabilir.</small><span asp-validation-for="Topics"></span></div><div class="check-field"><input asp-for="IsActive"/><label asp-for="IsActive"></label></div></div></section><div class="form-actions"><a class="admin-btn" asp-action="Index">Vazgeç</a><button class="admin-btn primary">@(edit?"Değişiklikleri Kaydet":"Sınıfı Ekle")</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
