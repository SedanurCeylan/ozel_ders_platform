@model TeacherProfileViewModel
@{ ViewData["Title"] = "Öğretmen Bilgileri"; }
<div class="page-heading"><div><span>Hakkımda sayfası</span><h1>Öğretmen Bilgileri</h1><p>Hakkımda sayfasında görünen bilgileri tek ekrandan kolayca düzenleyin.</p></div><a class="admin-btn" asp-area="" asp-controller="Home" asp-action="About" target="_blank">Sayfayı Gör ↗</a></div>
<div class="teacher-editor-note"><span>i</span><div><strong>Nasıl kullanılır?</strong><p>Alanları güncelleyin ve alttaki kaydet düğmesine basın. Teknik ayar veya kod değişikliği gerekmez.</p></div></div>
<form method="post" class="admin-form teacher-profile-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <section class="form-card"><div class="form-card-title"><span>01</span><div><h2>Kimlik ve mesleki bilgiler</h2><p>Ziyaretçinin öğretmeni gerçekten tanımasını sağlayan temel bilgiler.</p></div></div><div class="form-grid"><div><label asp-for="TeacherName"></label><input asp-for="TeacherName" placeholder="Örn. Seda Ceylan"/><span asp-validation-for="TeacherName"></span></div><div><label asp-for="ProfessionalTitle"></label><input asp-for="ProfessionalTitle" placeholder="Örn. Matematik Öğretmeni"/><span asp-validation-for="ProfessionalTitle"></span></div><div><label asp-for="Education"></label><textarea asp-for="Education" rows="4" placeholder="Üniversite, bölüm ve varsa eğitimler"></textarea><span asp-validation-for="Education"></span></div><div><label asp-for="Experience"></label><textarea asp-for="Experience" rows="4" placeholder="Deneyim yılı ve uzmanlık alanları"></textarea><span asp-validation-for="Experience"></span></div><div class="wide"><label asp-for="LessonFormat"></label><input asp-for="LessonFormat" placeholder="Örn. 5–8. sınıf, çevrim içi ve yüz yüze birebir ders"/><span asp-validation-for="LessonFormat"></span></div></div></section>
    <section class="form-card"><div class="form-card-title"><span>02</span><div><h2>Tanıtım yazısı</h2><p>Hakkımda sayfasının ana mesajı ve size ait kısa bir söz.</p></div></div><div class="form-grid one"><div><label asp-for="AboutTitle"></label><input asp-for="AboutTitle"/><span asp-validation-for="AboutTitle"></span></div><div><label asp-for="AboutDescription"></label><textarea asp-for="AboutDescription" rows="5"></textarea><span asp-validation-for="AboutDescription"></span></div><div><label asp-for="Quote"></label><textarea asp-for="Quote" rows="3"></textarea><span asp-validation-for="Quote"></span></div></div></section>
    <section class="form-card"><div class="form-card-title"><span>03</span><div><h2>Eğitim yaklaşımı</h2><p>Ders verme biçiminizi ve öğrencilerle çalışma yaklaşımınızı anlatın.</p></div></div><div class="form-grid"><div><label asp-for="ApproachTitle"></label><input asp-for="ApproachTitle"/><span asp-validation-for="ApproachTitle"></span></div><div><label asp-for="ApproachSubtitle"></label><input asp-for="ApproachSubtitle"/><span asp-validation-for="ApproachSubtitle"></span></div><div class="wide"><label asp-for="ApproachContent"></label><textarea asp-for="ApproachContent" rows="5"></textarea><span asp-validation-for="ApproachContent"></span></div></div></section>
    <section class="form-card"><div class="form-card-title"><span>04</span><div><h2>Öne çıkan değerler</h2><p>Hakkımda sayfasındaki üç kısa bilgi kartı.</p></div></div><div class="teacher-values-grid"><div><label asp-for="FirstValueTitle"></label><input asp-for="FirstValueTitle"/><label asp-for="FirstValueContent"></label><textarea asp-for="FirstValueContent" rows="4"></textarea></div><div><label asp-for="SecondValueTitle"></label><input asp-for="SecondValueTitle"/><label asp-for="SecondValueContent"></label><textarea asp-for="SecondValueContent" rows="4"></textarea></div><div><label asp-for="ThirdValueTitle"></label><input asp-for="ThirdValueTitle"/><label asp-for="ThirdValueContent"></label><textarea asp-for="ThirdValueContent" rows="4"></textarea></div></div></section>
    <div class="form-actions"><a class="admin-btn" asp-controller="Dashboard" asp-action="Index">Vazgeç</a><button class="admin-btn primary" type="submit">Öğretmen Bilgilerini Kaydet</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
