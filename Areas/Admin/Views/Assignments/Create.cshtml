@model AssignmentFormViewModel
@{ ViewData["Title"] = "Yeni Ödev"; }
<div class="page-heading"><div><span>Ödev yönetimi</span><h1>Yeni Ödev Oluştur</h1><p>Ödevi hazırlayın ve bir veya daha fazla öğrenciye atayın.</p></div></div>
<form method="post" enctype="multipart/form-data" class="admin-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><section class="form-card"><div class="form-grid">
<div class="wide"><label asp-for="Assignment.Title"></label><input asp-for="Assignment.Title"/><span asp-validation-for="Assignment.Title"></span></div><div class="wide"><label asp-for="Assignment.ShortDescription"></label><input asp-for="Assignment.ShortDescription"/><span asp-validation-for="Assignment.ShortDescription"></span></div><div class="wide"><label asp-for="Assignment.Description"></label><textarea asp-for="Assignment.Description" rows="6"></textarea></div>
<div><label asp-for="Assignment.Subject"></label><input asp-for="Assignment.Subject"/></div><div><label asp-for="Assignment.GradeLevel"></label><input asp-for="Assignment.GradeLevel" placeholder="Örn. 8. Sınıf"/></div><div><label asp-for="Assignment.StartDate"></label><input asp-for="Assignment.StartDate" type="datetime-local"/></div><div><label asp-for="Assignment.DueDate"></label><input asp-for="Assignment.DueDate" type="datetime-local"/></div><div><label asp-for="Assignment.MaximumScore"></label><input asp-for="Assignment.MaximumScore" type="number"/></div><div><label asp-for="Assignment.Status"></label><select asp-for="Assignment.Status"><option value="Draft">Taslak</option><option value="Published">Yayında</option><option value="InProgress">Devam ediyor</option><option value="AwaitingSubmission">Teslim bekliyor</option></select></div>
<div class="wide"><label asp-for="SelectedStudentIds">Atanacak öğrenciler</label><select asp-for="SelectedStudentIds" asp-items="Model.Students" multiple size="7"></select><span asp-validation-for="SelectedStudentIds"></span><small>Birden fazla öğrenci seçebilirsiniz.</small></div><div class="wide"><label asp-for="Attachment">Ödev eki</label><input asp-for="Attachment" type="file" accept=".pdf,.jpg,.jpeg,.png,.docx"/><small>PDF, JPG, PNG veya DOCX; en fazla 20 MB.</small></div>
<div class="check-field"><input asp-for="Assignment.AllowLateSubmission"/><label asp-for="Assignment.AllowLateSubmission"></label></div><div class="check-field"><input asp-for="Assignment.AllowFileUpload"/><label asp-for="Assignment.AllowFileUpload"></label></div><div class="check-field"><input asp-for="Assignment.AllowStudentComment"/><label asp-for="Assignment.AllowStudentComment"></label></div><div class="check-field"><input asp-for="Assignment.SendEmailNotification"/><label asp-for="Assignment.SendEmailNotification"></label></div>
</div></section><div class="form-actions"><a class="admin-btn" asp-action="Index">Vazgeç</a><button class="admin-btn primary" type="submit">Ödevi Oluştur</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
