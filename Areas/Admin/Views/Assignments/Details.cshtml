@model Assignment
@{ ViewData["Title"] = "Ödev Ayrıntıları"; }
<div class="page-heading"><div><span>@Model.Subject · @Model.DueDate.ToString("dd MMMM yyyy HH:mm")</span><h1>@Model.Title</h1><p>@Model.ShortDescription</p></div><div><a class="admin-btn" asp-action="Index">← Ödevler</a> <a class="admin-btn primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a></div></div>
<div class="detail-grid"><section class="admin-panel"><h2>Ödev Bilgileri</h2><p>@Model.Description</p><dl><dt>Durum</dt><dd>@Model.Status.ToTurkish()</dd><dt>Maksimum puan</dt><dd>@Model.MaximumScore</dd><dt>Geç teslim</dt><dd>@(Model.AllowLateSubmission ? "Kabul edilir" : "Kabul edilmez")</dd></dl>@if (!string.IsNullOrWhiteSpace(Model.AttachmentPath)) { <a class="admin-btn primary" asp-action="DownloadAttachment" asp-route-id="@Model.Id">Ödev ekini indir ↓</a> }</section><section class="admin-panel"><h2>Teslim Özeti</h2><p>@Model.StudentAssignments.Count öğrenciye atandı.</p><strong>@Model.StudentAssignments.Count(x => x.SubmittedAt.HasValue) teslim alındı</strong></section></div>
<section class="attendance-section"><div class="panel-head"><div><h2>Öğrenci Teslimleri</h2><p>Puan ve geri bildirim ekleyin.</p></div></div>@foreach (var item in Model.StudentAssignments) { <form asp-action="Evaluate" asp-route-id="@item.Id" method="post" class="assignment-evaluate"><div class="student-cell"><span>@item.StudentProfile.FirstName[0]@item.StudentProfile.LastName[0]</span><div><strong>@item.StudentProfile.FullName</strong><small>@item.Status.ToTurkish() · @(item.SubmittedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Teslim edilmedi")</small></div></div><div class="submission-files">@foreach(var submission in item.Submissions.OrderByDescending(x => x.SubmissionNumber)){<span>@submission.SubmissionNumber. teslim @if(!string.IsNullOrWhiteSpace(submission.FilePath)){<a asp-action="DownloadSubmission" asp-route-id="@submission.Id">Dosyayı indir</a>}</span>}</div><input name="score" type="number" min="0" max="@Model.MaximumScore" value="@item.Score" placeholder="Puan"/><input name="feedback" value="@item.TeacherFeedback" placeholder="Öğretmen geri bildirimi"/><label><input type="checkbox" name="requestResubmission" value="true"/> Yeniden teslim iste</label><button class="admin-btn" type="submit">Değerlendir</button></form> }</section>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="danger-zone" onsubmit="return confirm('Ödev iptal edilsin mi? Teslim geçmişi korunacaktır.');"><div><strong>Ödevi iptal et</strong><p>Öğrenci teslimleri varsa kayıt silinmez ve iptal durumuna alınır.</p></div><button>İptal Et</button></form>
