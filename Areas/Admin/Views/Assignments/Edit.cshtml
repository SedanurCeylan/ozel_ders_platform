@model AssignmentFormViewModel
@{ViewData["Title"]="Ödevi Düzenle";}
<div class="page-heading"><div><span>Ödev yönetimi</span><h1>Ödevi Düzenle</h1><p>Bilgileri, son teslim tarihini ve öğrenci atamalarını güncelleyin.</p></div></div><form method="post" class="admin-form"><input asp-for="Assignment.Id" type="hidden"/><input asp-for="Assignment.CreatedAt" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><section class="form-card"><div class="form-grid"><div class="wide"><label asp-for="Assignment.Title"></label><input asp-for="Assignment.Title"/></div><div class="wide"><label asp-for="Assignment.ShortDescription"></label><input asp-for="Assignment.ShortDescription"/></div><div class="wide"><label asp-for="Assignment.Description"></label><textarea asp-for="Assignment.Description" rows="6"></textarea></div><div><label asp-for="Assignment.Subject"></label><input asp-for="Assignment.Subject"/></div><div><label asp-for="Assignment.GradeLevel"></label><input asp-for="Assignment.GradeLevel"/></div><div><label asp-for="Assignment.StartDate"></label><input asp-for="Assignment.StartDate" type="datetime-local"/></div><div><label asp-for="Assignment.DueDate"></label><input asp-for="Assignment.DueDate" type="datetime-local"/></div><div><label asp-for="Assignment.MaximumScore"></label><input asp-for="Assignment.MaximumScore" type="number"/></div><div><label asp-for="Assignment.Status"></label><select asp-for="Assignment.Status"><option value="Draft">Taslak</option><option value="Published">Yayında</option><option value="InProgress">Devam ediyor</option><option value="AwaitingSubmission">Teslim bekliyor</option><option value="Completed">Tamamlandı</option><option value="Expired">Süresi doldu</option><option value="Cancelled">İptal edildi</option></select></div><div class="wide"><label asp-for="SelectedStudentIds">Atanan öğrenciler</label><select asp-for="SelectedStudentIds" asp-items="Model.Students" multiple size="7"></select><small>Teslimi bulunan öğrenciler geçmişi korumak için atamadan çıkarılmaz.</small></div><div class="check-field"><input asp-for="Assignment.AllowLateSubmission"/><label asp-for="Assignment.AllowLateSubmission"></label></div><div class="check-field"><input asp-for="Assignment.AllowFileUpload"/><label asp-for="Assignment.AllowFileUpload"></label></div><div class="check-field"><input asp-for="Assignment.AllowStudentComment"/><label asp-for="Assignment.AllowStudentComment"></label></div><div class="check-field"><input asp-for="Assignment.SendEmailNotification"/><label asp-for="Assignment.SendEmailNotification"></label></div></div></section><div class="form-actions"><a class="admin-btn" asp-action="Details" asp-route-id="@Model.Assignment.Id">Vazgeç</a><button class="admin-btn primary">Değişiklikleri Kaydet</button></div></form>
