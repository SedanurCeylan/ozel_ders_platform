@model GameQuestion
<div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"/><div class="form-grid"><div><label asp-for="GradeLevel"></label><select asp-for="GradeLevel">@for(var grade=5;grade<=8;grade++){<option value="@grade">@grade. sınıf</option>}</select></div><div><label asp-for="Topic"></label><input asp-for="Topic" placeholder="Örn. Kesirler"/></div><div><label asp-for="DifficultyLevel"></label><select asp-for="DifficultyLevel"><option value="Easy">Kolay</option><option value="Medium">Orta</option><option value="Hard">Zor</option></select></div><div class="check-field"><input asp-for="IsActive"/><label asp-for="IsActive"></label></div><div class="wide"><label asp-for="QuestionText"></label><textarea asp-for="QuestionText" rows="3"></textarea></div><div><label>Seçenek A</label><input name="optionA" value="@ViewBag.OptionA" required/></div><div><label>Seçenek B</label><input name="optionB" value="@ViewBag.OptionB" required/></div><div><label>Seçenek C</label><input name="optionC" value="@ViewBag.OptionC"/></div><div><label>Seçenek D</label><input name="optionD" value="@ViewBag.OptionD"/></div><div class="wide"><label asp-for="CorrectAnswer"></label><input asp-for="CorrectAnswer"/><small>Seçeneklerden biriyle aynı yazılmalıdır.</small></div><div class="wide"><label asp-for="Explanation"></label><textarea asp-for="Explanation" rows="4"></textarea></div></div>
