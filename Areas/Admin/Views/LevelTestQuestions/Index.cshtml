@model IReadOnlyList<GameQuestion>
@{ViewData["Title"]="Mini Test Soruları";}
<div class="page-heading"><div><span>Ana sayfa özellikleri</span><h1>Mini Test Soruları</h1><p>5, 6, 7 ve 8. sınıf mini seviye testlerinde kullanılacak soruları yönetin.</p></div><a class="admin-btn primary" asp-action="Create">+ Yeni Soru</a></div>
<form method="get" class="student-filters"><select name="grade"><option value="">Tüm sınıflar</option>@for(var grade=5;grade<=8;grade++){<option value="@grade" selected="@(ViewBag.Grade==grade)">@grade. sınıf</option>}</select><button class="admin-btn">Filtrele</button></form>
<div class="test-bank-summary">@for(var grade=5;grade<=8;grade++){var active=Model.Count(x=>x.GradeLevel==grade&&x.IsActive);<div><strong>@grade. sınıf</strong><span>@active aktif soru</span><small>@(active>=5?"Test hazır":"En az 5 aktif soru gerekli")</small></div>}</div>
<div class="table-card"><div class="responsive-table"><table><thead><tr><th>Sınıf</th><th>Konu</th><th>Soru</th><th>Zorluk</th><th>Durum</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="6" class="empty-state">Bu filtrede soru bulunmuyor.</td></tr>}@foreach(var item in Model){<tr><td>@item.GradeLevel. sınıf</td><td>@item.Topic</td><td><strong>@item.QuestionText</strong><small>Doğru cevap: @item.CorrectAnswer</small></td><td>@(item.DifficultyLevel==GameDifficulty.Easy?"Kolay":item.DifficultyLevel==GameDifficulty.Medium?"Orta":"Zor")</td><td><span class="status-pill @(item.IsActive?"on":"off")">@(item.IsActive?"Aktif":"Pasif")</span></td><td class="actions"><a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a><form asp-action="Toggle" asp-route-id="@item.Id" method="post"><button>@(item.IsActive?"Pasif Yap":"Aktif Yap")</button></form></td></tr>}</tbody></table></div></div>
