@model SiteSetting
@{
    ViewData["Title"] = "Site Ayarları";
}
<div class="page-heading"><div><span>Genel yapılandırma</span><h1>Site ve İletişim Ayarları</h1><p>Site adı, ana sayfa mesajı ve iletişim formu bağlantısını yönetin.</p></div><a class="admin-btn" asp-controller="TeacherProfile" asp-action="Index">Öğretmen Bilgilerine Git →</a></div>
<form method="post" class="admin-form">
    <input asp-for="Id" type="hidden" />
    <input asp-for="TeacherName" type="hidden" />
    <input asp-for="AboutTitle" type="hidden" />
    <input asp-for="AboutDescription" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <section class="form-card"><div class="form-card-title"><span>01</span><div><h2>Site ve iletişim</h2><p>Footer’da gösterilecek ve iletişim formunda kullanılacak iletişim bilgileri.</p></div></div><div class="form-grid"><div><label asp-for="SiteName"></label><input asp-for="SiteName" /><span asp-validation-for="SiteName"></span></div><div><label asp-for="Email"></label><input asp-for="Email" type="email" placeholder="iletisim@ornek.com"/><small>Footer’da gösterilir ve iletişim formunun alıcı adresi olarak kullanılır.</small><span asp-validation-for="Email"></span></div><div><label asp-for="Phone"></label><input asp-for="Phone" /><span asp-validation-for="Phone"></span></div><div class="wide"><label asp-for="InstagramUrl"></label><input asp-for="InstagramUrl" type="url" placeholder="https://www.instagram.com/kullaniciadi"/><span asp-validation-for="InstagramUrl"></span></div></div></section>
    <section class="form-card"><div class="form-card-title"><span>02</span><div><h2>Ana sayfa</h2><p>İlk ekranda görünen ana mesaj.</p></div></div><div class="form-grid one"><div><label asp-for="HeroTitle"></label><input asp-for="HeroTitle" /><span asp-validation-for="HeroTitle"></span></div><div><label asp-for="HeroDescription"></label><textarea asp-for="HeroDescription" rows="4"></textarea><span asp-validation-for="HeroDescription"></span></div></div></section>
    <section class="form-card"><div class="form-card-title"><span>03</span><div><h2>İletişim formu · EmailJS</h2><p>EmailJS panelindeki Service ID, Template ID ve Public Key değerlerini girin. EmailJS özel anahtarını buraya yazmayın.</p></div></div><div class="form-grid"><div><label asp-for="EmailJsServiceId"></label><input asp-for="EmailJsServiceId" placeholder="service_xxxxx"/><span asp-validation-for="EmailJsServiceId"></span></div><div><label asp-for="EmailJsTemplateId"></label><input asp-for="EmailJsTemplateId" placeholder="template_xxxxx"/><span asp-validation-for="EmailJsTemplateId"></span></div><div class="wide"><label asp-for="EmailJsPublicKey"></label><input asp-for="EmailJsPublicKey" placeholder="EmailJS public key"/><span asp-validation-for="EmailJsPublicKey"></span></div></div></section>
    <div class="form-actions"><a class="admin-btn" asp-controller="Dashboard" asp-action="Index">Vazgeç</a><button class="admin-btn primary" type="submit">Değişiklikleri Kaydet</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
