@model TeacherStudentNote
@{ ViewData["Title"]="Özel Not Ekle"; }
<div class="page-heading"><div><span>Yalnızca yönetici</span><h1>Özel Öğretmen Notu</h1><p>Bu içerik öğrenci panelinde gösterilmez.</p></div></div><form method="post" class="admin-form"><input asp-for="StudentProfileId" type="hidden"/><section class="form-card"><div class="form-grid"><div class="wide"><label asp-for="Title"></label><input asp-for="Title"/></div><div><label asp-for="Category"></label><select asp-for="Category"><option value="General">Genel</option><option value="Academic">Akademik</option><option value="Assignment">Ödev</option><option value="Attendance">Katılım</option><option value="ParentMeeting">Veli görüşmesi</option><option value="Progress">Gelişim</option><option value="Reminder">Hatırlatma</option></select></div><div class="check-field"><input asp-for="IsImportant"/><label asp-for="IsImportant"></label></div><div class="wide"><label asp-for="Description"></label><textarea asp-for="Description" rows="6"></textarea></div></div></section><div class="form-actions"><a class="admin-btn" asp-action="Index" asp-route-studentId="@Model.StudentProfileId">Vazgeç</a><button class="admin-btn primary">Notu Kaydet</button></div></form>
