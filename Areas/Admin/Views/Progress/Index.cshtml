@model StudentProgressViewModel
@{ ViewData["Title"] = "Gelişim Takibi"; }
<div class="page-heading"><div><span>Akademik takip</span><h1>Gelişim Takibi</h1><p>Deneme sonuçlarını, konu gelişimini ve özel notları yönetin.</p></div></div>
<form method="get" class="student-filters"><select name="studentId" onchange="this.form.submit()"><option value="">Öğrenci seçin</option>@foreach(StudentProfile student in ViewBag.Students){<option value="@student.Id" selected="@(Model.Student?.Id==student.Id)">@student.FullName · @student.GradeLevel</option>}</select></form>
@if(Model.Student is not null){<div class="student-profile-head"><div class="profile-avatar">@Model.Student.FirstName[0]@Model.Student.LastName[0]</div><div><h1>@Model.Student.FullName</h1><p>@Model.Student.GradeLevel · @Model.Student.SchoolName</p></div><div class="profile-actions"><a class="admin-btn" asp-action="CreateExam" asp-route-studentId="@Model.Student.Id">+ Deneme sonucu</a><a class="admin-btn" asp-action="CreateProgress" asp-route-studentId="@Model.Student.Id">+ Gelişim kaydı</a><a class="admin-btn primary" asp-action="CreateNote" asp-route-studentId="@Model.Student.Id">+ Özel not</a></div></div>
<div class="progress-columns"><section class="admin-panel"><div class="panel-head"><div><h2>Deneme Sonuçları</h2><p>Net değişimi ve sınav geçmişi</p></div></div><div class="chart-wrap"><canvas id="examChart"></canvas></div><div class="progress-list">@foreach(var item in Model.ExamResults){<article><div><strong>@item.ExamName</strong><small>@item.ExamDate.ToString("dd.MM.yyyy") · @item.CorrectCount D / @item.WrongCount Y / @item.EmptyCount B</small></div><b>@item.NetScore.ToString("0.##") net</b><form asp-action="DeleteExam" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Deneme sonucu silinsin mi?')"><button>Sil</button></form></article>}</div></section>
<section class="admin-panel"><div class="panel-head"><div><h2>Konu Gelişimi</h2><p>Kazanım ve eksik konular</p></div></div><div class="progress-list">@foreach(var item in Model.ProgressRecords){<article><div><strong>@item.Topic</strong><small>@item.StatusName · @item.TeacherComment</small><span><i style="width:@item.SuccessPercentage%"></i></span></div><b>%@item.SuccessPercentage</b><form asp-action="DeleteProgress" asp-route-id="@item.Id" method="post"><button>Sil</button></form></article>}</div></section></div>
<section class="attendance-section"><div class="panel-head"><div><h2>Özel Öğretmen Notları</h2><p>Bu notlar öğrenciye gösterilmez.</p></div></div><div class="note-grid">@foreach(var note in Model.TeacherNotes){<article class="@(note.IsImportant?"important":"")"><small>@note.CategoryName · @note.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small><h3>@note.Title</h3><p>@note.Description</p><form asp-action="DeleteNote" asp-route-id="@note.Id" method="post"><button>Notu sil</button></form></article>}</div></section>
@section Scripts { <script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>new Chart(document.getElementById('examChart'),{type:'line',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExamResults.Select(x=>x.ExamDate.ToString("dd.MM.yyyy")))),datasets:[{label:'Net',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExamResults.Select(x=>x.NetScore))),borderColor:'#ee735b',backgroundColor:'rgba(238,115,91,.12)',fill:true,tension:.3}]},options:{responsive:true,plugins:{legend:{display:false}}}});</script> }}
