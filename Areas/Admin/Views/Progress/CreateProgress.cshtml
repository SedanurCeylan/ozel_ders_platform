@model StudentProgress
@{ ViewData["Title"]="Gelişim Kaydı Ekle"; }
<div class="page-heading"><div><span>Gelişim takibi</span><h1>Konu Gelişimi Ekle</h1></div></div><form method="post" class="admin-form"><input asp-for="StudentProfileId" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><section class="form-card"><div class="form-grid"><div class="wide"><label asp-for="Topic"></label><input asp-for="Topic"/></div><div><label asp-for="ProgressStatus"></label><select asp-for="ProgressStatus"><option value="NotStarted">Başlanmadı</option><option value="InProgress">Devam ediyor</option><option value="Completed">Tamamlandı</option><option value="NeedsImprovement">Geliştirilmeli</option></select></div><div><label asp-for="SuccessPercentage"></label><input asp-for="SuccessPercentage" type="number" min="0" max="100"/></div><div><label asp-for="EvaluatedAt"></label><input asp-for="EvaluatedAt" type="date"/></div><div class="wide"><label asp-for="TeacherComment"></label><textarea asp-for="TeacherComment" rows="4"></textarea></div><div class="wide check-field"><input asp-for="NotifyParent"/><label asp-for="NotifyParent"></label><span asp-validation-for="NotifyParent" class="text-danger"></span></div></div></section><div class="form-actions"><a class="admin-btn" asp-action="Index" asp-route-studentId="@Model.StudentProfileId">Vazgeç</a><button class="admin-btn primary">Kaydet</button></div></form>
