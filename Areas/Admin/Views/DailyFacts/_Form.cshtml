@model DailyFact
<div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"/><div class="form-grid"><div class="wide"><label asp-for="Title"></label><input asp-for="Title" placeholder="Örn. Sıfır neden önemlidir?"/></div><div><label asp-for="Category"></label><select asp-for="Category"><option>Genel Matematik</option><option>Sayılar</option><option>Geometri</option><option>Matematik Tarihi</option><option>Günlük Hayatta Matematik</option><option>İlginç Matematik</option></select></div><div><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" type="number" min="1"/></div><div class="wide"><label asp-for="Content"></label><textarea asp-for="Content" rows="6"></textarea></div><div class="check-field"><input asp-for="IsActive"/><label asp-for="IsActive"></label></div></div>
