@model IReadOnlyList<DailyFact>
@{ViewData["Title"]="Günün Bilgileri";var active=Model.Count(x=>x.IsActive);}
<div class="page-heading"><div><span>Ana sayfa içerikleri</span><h1>Günün Bilgileri</h1><p>Her gün sırayla gösterilecek ilginç matematik bilgilerini yönetin.</p></div><a class="admin-btn primary" asp-action="Create">+ Yeni Bilgi</a></div><div class="fact-summary"><div><strong>@Model.Count</strong><span>Toplam bilgi</span></div><div><strong>@active</strong><span>Aktif bilgi</span></div><div><strong>@active</strong><span>Günlük dönüşüm</span></div></div><div class="table-card"><div class="responsive-table"><table><thead><tr><th>Sıra</th><th>Kategori</th><th>Başlık ve bilgi</th><th>Durum</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="5" class="empty-state">Henüz bilgi eklenmedi. <a asp-action="Create">İlk bilgiyi ekleyin.</a></td></tr>}@foreach(var item in Model){<tr><td><strong>@item.DisplayOrder</strong></td><td>@item.Category</td><td><strong>@item.Title</strong><small>@(item.Content.Length>140?item.Content[..140]+"…":item.Content)</small></td><td><span class="status-pill @(item.IsActive?"on":"off")">@(item.IsActive?"Aktif":"Pasif")</span></td><td class="actions"><form asp-action="Toggle" asp-route-id="@item.Id" method="post"><button>@(item.IsActive?"Gizle":"Yayınla")</button></form><a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu bilgi silinsin mi?')"><button>Sil</button></form></td></tr>}</tbody></table></div></div>
