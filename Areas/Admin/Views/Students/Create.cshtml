@model StudentCreateViewModel
@{ ViewData["Title"] = "Yeni Öğrenci"; }
<div class="page-heading"><div><span>Öğrenci yönetimi</span><h1>Yeni Öğrenci</h1><p>Öğrenci, veli ve ders bilgilerini kaydedin.</p></div></div>
<form method="post" enctype="multipart/form-data" class="admin-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><section class="form-card"><div class="form-card-title"><span>01</span><div><h2>Öğrenci profili</h2><p>Temel kayıt ve iletişim bilgileri.</p></div></div><partial name="_StudentFields" for="Student"/><div class="form-grid profile-upload-create"><div class="wide"><label asp-for="ProfileImage"></label><input asp-for="ProfileImage" type="file" accept=".jpg,.jpeg,.png"/><span asp-validation-for="ProfileImage"></span><small>JPG veya PNG; en fazla 5 MB.</small></div></div></section><section class="form-card"><div class="form-card-title"><span>02</span><div><h2>Giriş hesabı</h2><p>Öğrencinin kendi paneline girebilmesi için isteğe bağlı hesap.</p></div></div><div class="form-grid"><div class="check-field"><input asp-for="CreateAccount"/><label asp-for="CreateAccount"></label></div><div><label asp-for="TemporaryPassword"></label><input asp-for="TemporaryPassword" placeholder="En az 10 karakter"/><span asp-validation-for="TemporaryPassword"></span></div></div><p class="form-note">Geçici şifre veritabanına düz metin olarak kaydedilmez. Öğrenci ilk girişte şifresini değiştirmelidir.</p></section><div class="form-actions"><a class="admin-btn" asp-action="Index">Vazgeç</a><button class="admin-btn primary" type="submit">Öğrenciyi Kaydet</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
