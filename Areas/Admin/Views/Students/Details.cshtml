@model StudentDetailViewModel
@{var student=Model.Student;ViewData["Title"]=student.FullName;}
<div class="student-profile-head"><div class="profile-avatar">@if(!string.IsNullOrWhiteSpace(student.ProfileImagePath)){<img src="@Url.Action("Photo","Students",new{id=student.Id})" alt="@student.FullName"/>}else{@student.FirstName[0]@student.LastName[0]}</div><div><span class="status-pill @(student.IsActive?"on":"off")">@(student.IsActive?"Aktif öğrenci":"Pasif öğrenci")</span><h1>@student.FullName</h1><p>@student.GradeLevel · @(student.SchoolName??"Okul belirtilmemiş")</p></div><div class="profile-actions"><a class="admin-btn" asp-action="Index">← Liste</a><a class="admin-btn" asp-controller="Lessons" asp-action="Create">+ Ders</a><a class="admin-btn" asp-controller="Assignments" asp-action="Create">+ Ödev</a><a class="admin-btn" asp-action="SendEmail" asp-route-id="@student.Id">E-posta</a>@if(string.IsNullOrWhiteSpace(student.ApplicationUserId)){<a class="admin-btn" asp-action="CreateAccount" asp-route-id="@student.Id">Hesap Oluştur</a>}else{<a class="admin-btn" asp-action="ResetPassword" asp-route-id="@student.Id">Şifre Sıfırla</a>}<a class="admin-btn primary" asp-action="Edit" asp-route-id="@student.Id">Düzenle</a></div></div><form asp-action="UploadPhoto" asp-route-id="@student.Id" method="post" enctype="multipart/form-data" class="profile-photo-form"><label>Profil fotoğrafını değiştir <input type="file" name="profileImage" accept=".jpg,.jpeg,.png"/></label><button class="admin-btn">Fotoğrafı Yükle</button></form>
<div class="student-detail-stats"><article><small>Katılım oranı</small><strong>%@Model.AttendanceRate</strong></article><article><small>Ödev başarısı</small><strong>%@Model.AssignmentSuccessRate</strong></article><article><small>Toplam ders</small><strong>@Model.Lessons.Count</strong></article><article><small>Toplam ödev</small><strong>@Model.Assignments.Count</strong></article><article><small>Son net</small><strong>@(Model.ExamResults.FirstOrDefault()?.NetScore.ToString("0.##")??"—")</strong></article></div>
<nav class="detail-tabs" aria-label="Öğrenci ayrıntıları"><button class="active" data-tab="general">Genel Bilgiler</button><button data-tab="lessons">Ders Programı</button><button data-tab="assignments">Ödevler</button><button data-tab="documents">Dokümanlar</button><button data-tab="attendance">Katılım</button><button data-tab="exams">Deneme Sonuçları</button><button data-tab="progress">Gelişim</button><button data-tab="notes">Özel Notlar</button><button data-tab="emails">E-posta Geçmişi</button></nav>

<section class="detail-tab-panel active" data-panel="general"><div class="detail-grid"><section class="admin-panel"><div class="panel-head"><div><h2>İletişim Bilgileri</h2></div></div><dl><dt>E-posta</dt><dd>@student.Email</dd><dt>Telefon</dt><dd>@(student.Phone??"—")</dd><dt>Doğum tarihi</dt><dd>@(student.BirthDate?.ToString("dd.MM.yyyy")??"—")</dd><dt>Kayıt tarihi</dt><dd>@student.RegistrationDate.ToString("dd.MM.yyyy")</dd></dl></section><section class="admin-panel"><div class="panel-head"><div><h2>Veli Bilgileri</h2></div></div><dl><dt>Ad soyad</dt><dd>@student.ParentFirstName @student.ParentLastName</dd><dt>Telefon</dt><dd>@(student.ParentPhone??"—")</dd><dt>E-posta</dt><dd>@(student.ParentEmail??"—")</dd></dl></section><section class="admin-panel"><h2>Ders Bilgileri</h2><dl><dt>Ders</dt><dd>@student.LessonType</dd><dt>Tercih</dt><dd>@(student.LessonPreference=="Online"?"Çevrim içi":student.LessonPreference)</dd><dt>Sınıf</dt><dd>@student.GradeLevel</dd><dt>Okul</dt><dd>@(student.SchoolName??"—")</dd></dl></section><section class="admin-panel"><h2>Genel Öğretmen Notu</h2><p>@(student.TeacherNote??"Henüz genel not eklenmemiş.")</p></section></div></section>

<section class="detail-tab-panel" data-panel="lessons"><div class="record-list">@foreach(var item in Model.Lessons){<a asp-controller="Lessons" asp-action="Details" asp-route-id="@item.LessonId"><time>@item.Lesson.StartDate.ToString("dd MMM yyyy")<b>@item.Lesson.StartDate.ToString("HH:mm")</b></time><div><strong>@item.Lesson.Title</strong><small>@item.Lesson.Subject · @item.Lesson.LessonMode.ToTurkish()</small></div><span class="status-pill on">@item.Lesson.Status.ToTurkish()</span></a>}@if(Model.Lessons.Count==0){<div class="empty-state">Ders kaydı bulunmuyor.</div>}</div></section>
<section class="detail-tab-panel" data-panel="assignments"><div class="record-list">@foreach(var item in Model.Assignments){<a asp-controller="Assignments" asp-action="Details" asp-route-id="@item.AssignmentId"><time>@item.DueDate.ToString("dd MMM yyyy")<b>Son teslim</b></time><div><strong>@item.Assignment.Title</strong><small>@item.Assignment.Subject · @item.Status.ToTurkish()</small></div><span>@(item.Score.HasValue?$"{item.Score}/{item.Assignment.MaximumScore}":"Puan yok")</span></a>}@if(Model.Assignments.Count==0){<div class="empty-state">Ödev kaydı bulunmuyor.</div>}</div></section>
<section class="detail-tab-panel" data-panel="documents"><div class="record-list">@foreach(var item in Model.Documents){<a asp-controller="Documents" asp-action="Download" asp-route-id="@item.CourseDocumentId"><time>@item.AssignedAt.ToLocalTime().ToString("dd MMM yyyy")<b>Paylaşım</b></time><div><strong>@item.CourseDocument.Title</strong><small>@item.CourseDocument.Category · @(item.IsDownloaded?"İndirildi":"İndirilmedi")</small></div><span>İndir ↓</span></a>}@if(Model.Documents.Count==0){<div class="empty-state">Öğrenciye özel doküman kaydı bulunmuyor.</div>}</div></section>
<section class="detail-tab-panel" data-panel="attendance"><div class="detail-highlight"><strong>%@Model.AttendanceRate</strong><span>Genel katılım oranı</span></div><div class="record-list">@foreach(var item in Model.Lessons){<a asp-controller="Lessons" asp-action="Details" asp-route-id="@item.LessonId"><time>@item.Lesson.StartDate.ToString("dd.MM.yyyy")</time><div><strong>@item.Lesson.Title</strong><small>@(item.PerformanceNote??"Performans notu yok") · @(item.QuestionCount?.ToString()??"0") soru</small></div><span>@item.AttendanceStatus.ToTurkish()</span></a>}</div></section>
<section class="detail-tab-panel" data-panel="exams"><div class="record-list">@foreach(var item in Model.ExamResults){<a asp-controller="Progress" asp-action="Index" asp-route-studentId="@student.Id"><time>@item.ExamDate.ToString("dd MMM yyyy")</time><div><strong>@item.ExamName</strong><small>@item.CorrectCount doğru · @item.WrongCount yanlış · @item.EmptyCount boş</small></div><span>@item.NetScore.ToString("0.##") net</span></a>}@if(Model.ExamResults.Count==0){<div class="empty-state">Deneme sonucu bulunmuyor.</div>}</div></section>
<section class="detail-tab-panel" data-panel="progress"><div class="record-list">@foreach(var item in Model.ProgressRecords){<a asp-controller="Progress" asp-action="Index" asp-route-studentId="@student.Id"><time>@item.EvaluatedAt.ToString("dd MMM yyyy")</time><div><strong>@item.Topic</strong><small>@item.StatusName · @item.TeacherComment</small><i><b style="width:@item.SuccessPercentage%"></b></i></div><span>%@item.SuccessPercentage</span></a>}@if(Model.ProgressRecords.Count==0){<div class="empty-state">Gelişim kaydı bulunmuyor.</div>}</div></section>
<section class="detail-tab-panel" data-panel="notes"><div class="tab-action"><a class="admin-btn primary" asp-controller="Progress" asp-action="CreateNote" asp-route-studentId="@student.Id">+ Özel not ekle</a></div><div class="note-grid">@foreach(var item in Model.TeacherNotes){<article class="@(item.IsImportant?"important":"")"><small>@item.CategoryName · @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small><h3>@item.Title</h3><p>@item.Description</p></article>}@if(Model.TeacherNotes.Count==0){<div class="empty-state">Özel öğretmen notu bulunmuyor.</div>}</div></section>
<section class="detail-tab-panel" data-panel="emails"><div class="record-list">@foreach(var item in Model.EmailLogs){<a asp-controller="EmailLogs" asp-action="Details" asp-route-id="@item.Id"><time>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")<b>@item.CreatedAt.ToLocalTime().ToString("HH:mm")</b></time><div><strong>@item.Subject</strong><small>@item.EmailType · @(item.ErrorMessage??"Gönderim tamamlandı")</small></div><span class="status-pill @(item.IsSuccessful?"on":"off")">@(item.IsSuccessful?"Gönderildi":"Başarısız")</span></a>}@if(Model.EmailLogs.Count==0){<div class="empty-state">E-posta geçmişi bulunmuyor.</div>}</div></section>

<form asp-action="Delete" asp-route-id="@student.Id" method="post" class="danger-zone" onsubmit="return confirm('Öğrenci arşivlensin mi? Akademik geçmişi korunacaktır.');"><div><strong>Öğrenciyi arşivle</strong><p>Giriş hesabı pasifleştirilir, akademik geçmiş ve teslimler korunur.</p></div><button>Arşivle</button></form>
@section Scripts{<script>document.querySelectorAll('[data-tab]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.remove('active'));document.querySelectorAll('[data-panel]').forEach(x=>x.classList.remove('active'));button.classList.add('active');document.querySelector(`[data-panel="${button.dataset.tab}"]`).classList.add('active')}));</script>}
