@model OzelDersYonetim.Models.Students.StudentProfile
<div class="form-grid"><div><label asp-for="FirstName"></label><input asp-for="FirstName" /><span asp-validation-for="FirstName"></span></div><div><label asp-for="LastName"></label><input asp-for="LastName" /><span asp-validation-for="LastName"></span></div><div><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email"></span></div><div><label asp-for="Phone"></label><input asp-for="Phone" /><span asp-validation-for="Phone"></span></div><div><label asp-for="BirthDate"></label><input asp-for="BirthDate" type="date" /></div><div><label asp-for="GradeLevel"></label><select asp-for="GradeLevel"><option value="">Sınıf seçin</option>@for(var grade=5;grade<=12;grade++){<option value="@grade. Sınıf">@grade. Sınıf</option>}</select><span asp-validation-for="GradeLevel"></span></div><div class="wide"><label asp-for="SchoolName"></label><input asp-for="SchoolName" /></div></div>
<h3 class="form-subtitle">Veli bilgileri</h3><div class="form-grid"><div><label asp-for="ParentFirstName"></label><input asp-for="ParentFirstName" /></div><div><label asp-for="ParentLastName"></label><input asp-for="ParentLastName" /></div><div><label asp-for="ParentPhone"></label><input asp-for="ParentPhone" /></div><div><label asp-for="ParentEmail"></label><input asp-for="ParentEmail" /><span asp-validation-for="ParentEmail"></span></div></div>
<h3 class="form-subtitle">Ders bilgileri</h3><div class="form-grid"><div><label asp-for="LessonType"></label><input asp-for="LessonType" /></div><div><label asp-for="LessonPreference"></label><select asp-for="LessonPreference"><option value="Online">Çevrim içi</option><option>Yüz yüze</option><option>Hibrit</option></select></div><div><label asp-for="RegistrationDate"></label><input asp-for="RegistrationDate" type="date" /></div><div class="check-field"><input asp-for="IsActive" /><label asp-for="IsActive"></label></div><div class="wide"><label asp-for="TeacherNote"></label><textarea asp-for="TeacherNote" rows="5"></textarea></div></div>
