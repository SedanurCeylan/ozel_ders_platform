@model StudentAccountCreateViewModel
@{ViewData["Title"]="Öğrenci Hesabı Oluştur";}
<div class="page-heading"><div><span>Giriş hesabı</span><h1>Öğrenci Hesabı Oluştur</h1><p>@Model.StudentName için öğrenci paneli erişimi oluşturun.</p></div></div><form method="post" class="admin-form"><input asp-for="StudentId" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><section class="form-card"><div class="form-grid one"><div><label>E-posta adresi</label><input value="@Model.Email" disabled/><small>Bu adres öğrencinin kullanıcı adı olacaktır.</small></div><div><label asp-for="TemporaryPassword"></label><input asp-for="TemporaryPassword" autocomplete="new-password"/><span asp-validation-for="TemporaryPassword"></span><small>En az 10 karakter; büyük ve küçük harf, rakam ve özel karakter içermelidir.</small></div></div><p class="form-note">Öğrenci ilk girişte şifresini değiştirmeye yönlendirilir. Geçici şifre veritabanında düz metin saklanmaz.</p></section><div class="form-actions"><a class="admin-btn" asp-action="Details" asp-route-id="@Model.StudentId">Vazgeç</a><button class="admin-btn primary">Hesabı Oluştur</button></div></form>
