@model IReadOnlyList<StudentListItemViewModel>
@{ ViewData["Title"] = "Öğrenciler"; }
<div class="page-heading"><div><span>Öğrenci yönetimi</span><h1>Tüm Öğrenciler</h1><p>Öğrenci kayıtlarını, derslerini ve ödev durumlarını yönetin.</p></div><a class="admin-btn primary" asp-action="Create">+ Yeni öğrenci</a></div>
<form method="get" class="student-filters expanded"><input name="search" value="@ViewBag.Search" placeholder="Ad, soyad veya e-posta ara"/><select name="grade"><option value="">Tüm sınıflar</option>@for(var grade=5;grade<=12;grade++){<option value="@grade. Sınıf" selected="@(ViewBag.Grade==grade+". Sınıf")">@grade. Sınıf</option>}</select><select name="active"><option value="">Tüm durumlar</option><option value="true" selected="@(ViewBag.Active==true)">Aktif</option><option value="false" selected="@(ViewBag.Active==false)">Pasif</option></select><select name="lessonPreference"><option value="">Tüm ders biçimleri</option><option value="Online" selected="@(ViewBag.LessonPreference=="Online")">Çevrim içi</option><option value="Yüz yüze" selected="@(ViewBag.LessonPreference=="Yüz yüze")">Yüz yüze</option><option value="Hibrit" selected="@(ViewBag.LessonPreference=="Hibrit")">Hibrit</option></select><select name="assignmentStatus"><option value="">Tüm ödev durumları</option><option value="pending" selected="@(ViewBag.AssignmentStatus=="pending")">Bekleyen ödevi var</option><option value="submitted" selected="@(ViewBag.AssignmentStatus=="submitted")">Teslimi var</option></select><select name="sort"><option value="">Ada göre</option><option value="newest" selected="@(ViewBag.Sort=="newest")">En yeni kayıt</option><option value="oldest" selected="@(ViewBag.Sort=="oldest")">En eski kayıt</option></select><button class="admin-btn" type="submit">Filtrele</button></form>
<div class="table-card"><div class="responsive-table"><table><thead><tr><th>Öğrenci</th><th>Sınıf</th><th>Telefon</th><th>Veli</th><th>Ders</th><th>Son ders</th><th>Bekleyen ödev</th><th>Hesap</th><th></th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="9" class="empty-state">Filtrelere uygun öğrenci bulunamadı.</td></tr>}@foreach(var row in Model){var item=row.Student;<tr><td><div class="student-cell"><span>@item.FirstName[0]@item.LastName[0]</span><div><strong>@item.FullName</strong><small>@item.Email</small></div></div></td><td>@item.GradeLevel</td><td>@(item.Phone??"—")</td><td><strong>@item.ParentFirstName @item.ParentLastName</strong><small>@item.ParentPhone</small></td><td><strong>@item.LessonType</strong><small>@(item.LessonPreference=="Online"?"Çevrim içi":item.LessonPreference)</small></td><td>@(row.LastLessonDate?.ToString("dd.MM.yyyy")??"—")</td><td><span class="assignment-count @(row.PendingAssignmentCount>0?"has":"")">@row.PendingAssignmentCount</span></td><td><span class="status-pill @(item.IsActive?"on":"off")">@(item.IsActive?"Aktif":"Pasif")</span></td><td class="actions"><a asp-action="Details" asp-route-id="@item.Id">Detay</a><a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a><a asp-controller="Lessons" asp-action="Create">Ders ekle</a><a asp-controller="Assignments" asp-action="Create">Ödev ata</a><form asp-action="ToggleActive" asp-route-id="@item.Id" method="post"><button>@(item.IsActive?"Pasif yap":"Aktif yap")</button></form></td></tr>}</tbody></table></div></div>
