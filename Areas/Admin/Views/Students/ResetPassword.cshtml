@model StudentPasswordResetViewModel
@{ViewData["Title"]="Şifre Sıfırla";}
<div class="page-heading"><div><span>Hesap güvenliği</span><h1>Şifre Sıfırla</h1><p>@Model.StudentName için yeni bir geçici şifre belirleyin.</p></div></div><form method="post" class="admin-form"><input asp-for="StudentId" type="hidden"/><section class="form-card"><div class="form-grid one"><div><label asp-for="TemporaryPassword"></label><input asp-for="TemporaryPassword" autocomplete="new-password"/><span asp-validation-for="TemporaryPassword"></span><small>En az 10 karakter; büyük ve küçük harf, rakam ve özel karakter içermelidir.</small></div></div><p class="form-note">Geçici şifre e-posta ile gönderilir ancak e-posta geçmişinde veya öğrenci kaydında düz metin olarak saklanmaz.</p></section><div class="form-actions"><a class="admin-btn" asp-action="Details" asp-route-id="@Model.StudentId">Vazgeç</a><button class="admin-btn primary">Şifreyi Sıfırla</button></div></form>
