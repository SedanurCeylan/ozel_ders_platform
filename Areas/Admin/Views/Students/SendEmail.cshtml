@model StudentEmailViewModel
@{ViewData["Title"]="E-posta Gönder";}
<div class="page-heading"><div><span>Özel bilgilendirme</span><h1>E-posta Gönder</h1><p>@Model.StudentName ve kayıtlı velisine özel mesaj gönderin.</p></div></div><form method="post" class="admin-form"><input asp-for="StudentId" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><section class="form-card"><div class="recipient-cards"><label><input asp-for="RecipientType" type="radio" value="Student"/><span><strong>Öğrenci</strong><small>@Model.StudentEmail</small></span></label><label class="@(string.IsNullOrWhiteSpace(Model.ParentEmail)?"disabled":"")"><input asp-for="RecipientType" type="radio" value="Parent" disabled="@string.IsNullOrWhiteSpace(Model.ParentEmail)"/><span><strong>Veli</strong><small>@(Model.ParentEmail??"E-posta kayıtlı değil")</small></span></label><label class="@(string.IsNullOrWhiteSpace(Model.ParentEmail)?"disabled":"")"><input asp-for="RecipientType" type="radio" value="Both" disabled="@string.IsNullOrWhiteSpace(Model.ParentEmail)"/><span><strong>Her ikisi</strong><small>Öğrenci ve veli</small></span></label></div><span asp-validation-for="RecipientType"></span><div class="form-grid one email-compose"><div><label asp-for="Subject"></label><input asp-for="Subject"/><span asp-validation-for="Subject"></span></div><div><label asp-for="Message"></label><textarea asp-for="Message" rows="10" placeholder="Göndermek istediğiniz bilgilendirmeyi yazın..."></textarea><span asp-validation-for="Message"></span></div></div><p class="form-note">Mesaj Matematik Atölyesi HTML şablonuyla gönderilir ve gönderim sonucu e-posta geçmişine kaydedilir.</p></section><div class="form-actions"><a class="admin-btn" asp-action="Details" asp-route-id="@Model.StudentId">Vazgeç</a><button class="admin-btn primary">E-postayı Gönder</button></div></form>
