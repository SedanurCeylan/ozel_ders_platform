@model IReadOnlyList<OzelDersYonetim.Models.Auditing.AuditLog>
@{ViewData["Title"]="İşlem Geçmişi";}
<div class="page-heading"><div><span>Güvenlik kayıtları</span><h1>İşlem Geçmişi</h1><p>Yönetici tarafından yapılan önemli işlemleri inceleyin.</p></div></div><form method="get" class="student-filters"><select name="actionType"><option value="">Tüm işlemler</option>@foreach(string action in ViewBag.Actions){<option value="@action" selected="@(ViewBag.ActionType==action)">@action</option>}</select><select name="entityType"><option value="">Tüm kayıt türleri</option>@foreach(string entity in ViewBag.Entities){<option value="@entity" selected="@(ViewBag.EntityType==entity)">@entity</option>}</select><button class="admin-btn">Filtrele</button></form><div class="table-card"><div class="responsive-table"><table><thead><tr><th>Tarih</th><th>İşlem</th><th>Kayıt türü</th><th>Açıklama</th><th>IP adresi</th></tr></thead><tbody>@if(Model.Count==0){<tr><td colspan="5" class="empty-state">Henüz işlem kaydı bulunmuyor.</td></tr>}@foreach(var item in Model){<tr><td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td><td><strong>@item.ActionType</strong></td><td>@item.EntityType #@item.EntityId</td><td>@item.Description</td><td>@(item.IpAddress??"—")</td></tr>}</tbody></table></div></div>
